{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid"> 

    <div class="panel panel-default">
      <div class="panel-body">
        <div class="table-responsive">
          {% if success %} 
            <div class="successDiv">{{ success }}</div> 
          {% endif %}
          <form action="{{ action }}" method="post" enctype="multipart/form-data">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td class="text-left">{{ text_category }}</td>
                  <td class="text-left">{{ text_date_create }}</td>
                  <td class="text-left">{{ text_download }}</td>
                  <td class="text-right">{{ text_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% for customer_group in customer_groups %}
                <tr>
                  <td class="text-left">{{ customer_group.name }}</td>
                  <td class="text-left">
                    Excel: {{ customer_group.prices.prices_date_excel }}<br/>
                    Pdf: {{ customer_group.prices.prices_date_pdf }}<br/>
                  </td>
                  <td class="text-left">
                    Excel: <a href="{{ customer_group.prices.prices_last_file_excel }}" target="_blank">{{ customer_group.prices.prices_last_file_excel_name }}</a><br/>
                    Pdf: <a href="{{ customer_group.prices.prices_last_file_pdf }}" target="_blank">{{ customer_group.prices.prices_last_file_pdf_name }}</a><br/>
                  </td>
                  <td class="text-right">
                     <a href="{{ customer_group.action_reload_excel }}" data-toggle="tooltip" title="" class="btn btn-primary" data-original-title="Обновить"><i class="fa fa-spinner"></i> excel</a>
                     <a href="{{ customer_group.action_reload_pdf }}" data-toggle="tooltip" title="" class="btn btn-primary" data-original-title="Обновить"><i class="fa fa-spinner"></i> pdf</a>
                     <a href="{{ customer_group.action_edit }}" data-toggle="tooltip" title="" class="btn btn-primary" data-original-title="Редактировать настройки"><i class="fa fa-pencil"></i></a>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </form>
        </div>   
      </div>
    </div>

  <style>
   .exportTableM label{
     display:block;
     width:100%;
     font-weight:normal;
   }
   .exportTableM input{
     display:block;
     margin:0px 0px 10px 0px;
   }
   .exportTableM > div{
    display:flex;
    flex-wrap: wrap;
    margin:0px 0px 0px 30px;
   }
   .exportTableM > div > div{
     width:calc(10% - 10px);
     margin:0px 0px 0px 10px;
   }
   .exportTableM > div div label{
     display:inline;
     width:auto;
   }
   .exportTableM > div div input{

   }
   .exportTableM hr{
     width: 100%;
   }
   .exportTableM .showBottom{
     margin:0px 0px 0px 10px;
   }
   .exportTableM .showBottomWrapper{
     display:none;
   }
   .exportTableM .showBottomWrapper.active{
     display:block;
   }
   .successDiv{
    margin:10px 0px 10px 0px;
    color:green;
    font-weight:bold;
   }
  </style>
  <script type="text/javascript">
    $(document).ready(function() {
      $('.showBottom').on('click', function() {
        var id = $(this).attr('attr-id');
        if($('.showBottomWrapper_'+id).hasClass('active')){
          $('.showBottomWrapper_'+id).removeClass('active');
        }else{
          $('.showBottomWrapper_'+id).addClass('active');
        }
      });
    });
  </script>
    
</div>
  			
{{ footer }} 