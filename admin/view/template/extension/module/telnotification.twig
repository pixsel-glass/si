{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
 
      <!-- Кнопки управления -->
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
 
      <!-- Название модуля -->
      <h1>{{ heading_title }}</h1>
 
      <!-- Хлебные крошки -->
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
 
    </div>
  </div>
 
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
         <div class="form-group">
           <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
           <div class="col-sm-10">
   
             <select name="module_telnotification_status" id="input-status" class="form-control">
               {% if module_telnotification_status %}
               <option value="1" selected="selected">{{ text_enabled }}</option>
               <option value="0">{{ text_disabled }}</option>
               {% else %}
               <option value="1">{{ text_enabled }}</option>
               <option value="0" selected="selected">{{ text_disabled }}</option>
               {% endif %}
             </select>
   
           </div>
         </div>
         <div class="form-group">
           <label class="col-sm-2 control-label" for="input-bot-id">{{ bot_id_label }}</label>
           <div class="col-sm-10">
             <input type="text" name="module_telnotification_bot_id"  id="input-bot-id" class="form-control" value="{{bot_id}}">
           </div>
         </div>
         <div class="form-group table-responsive">
           <table id="recipients" class="table table-striped table-bordered table-hover"> 
             <thead>
               <tr>
                 <td class="text-left">{{recipient_name}}</td>
                 <td class="text-left">{{recipient_id}}</td>
                 <td></td>
               </tr>
             </thead>
             <tbody>
              {% set count = 0 %}
              {%for key, value in recipients %}
                <tr id="recipient{{key}}">
                  <td class="text-left">
                    <input type="text" name="module_telnotification_recipients[{{key}}][name]" value="{{value['name']}}" placeholder="{{text_recipient_placeholder_name}}">
                  </td>
                  <td class="text-left">
                    <input type="text" name="module_telnotification_recipients[{{key}}][id]" value="{{value['id']}}" placeholder="{{text_recipient_placeholder_id}}"> 
                  </td>
                  <td class="text-left"><button type="button" onclick="$('#recipient{{ key }}, .tooltip').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
                </tr>
                {% set count = key %}
              {% endfor %}
             </tbody>
             <tfoot>
                  <tr>
                    <td colspan="2"></td>
                    <td class="text-left"><button type="button" onclick="addRecipient();" data-toggle="tooltip" title="add recipient" class="btn btn-primary" data-original-title="Add Recipient"><i class="fa fa-plus-circle"></i></button></td>
                  </tr>
                </tfoot>
           </table>
        </div>
        <div class="form-group">
           <label class="col-sm-2 control-label" for="textarea_message">
            <input type="checkbox" name="module_telnotification_neworder" {% if module_telnotification_neworder == 1 or module_telnotification_neworder == 'on' %}value="1" checked{% else %}value="0"{% endif %}>
            {{ textarea_message_label }}</label>
           <div class="col-sm-10">
             <p>{{textarea_message_description}}</p>
             <textarea type="text" name="module_telnotification_message" style="height: 200px;" placeholder="{{ textarea_message_example }}" id="textarea_message" class="form-control">{{module_telnotification_message}}</textarea>
           </div>
         </div>
        <div class="form-group">
           <label class="col-sm-2 control-label" for="textarea_quickorder_message">
            <input type="checkbox" name="module_telnotification_quickorder" {% if module_telnotification_quickorder == 1 or module_telnotification_quickorder == 'on' %}value="1" checked{% else %}value="0"{% endif %}>
           {{ textarea_quickorder_label }}</label>
           <div class="col-sm-10">
             <p>{{textarea_quickorder_description}}</p>
             <textarea type="text" name="module_telnotification_quickorder_message" style="height: 200px;" placeholder="{{ textarea_quickorder_example }}" id="textarea_quickorder_message" class="form-control">{{module_telnotification_quickorder_message}}</textarea>
           </div>
         </div>
        <div class="form-group">
           <label class="col-sm-2 control-label" for="textarea_callback_message">
            <input type="checkbox" name="module_telnotification_callback" {% if module_telnotification_callback == 1 or module_telnotification_callback == 'on' %}value="1" checked{% else %}value="0"{% endif %}>
           {{ textarea_callback_label }}</label>
           <div class="col-sm-10">
             <p>{{textarea_callback_description}}</p>
             <textarea type="text" name="module_telnotification_callback_message" style="height: 200px;" placeholder="{{ textarea_callback_example }}" id="textarea_callback_message" class="form-control">{{module_telnotification_callback_message}}</textarea>
           </div>
         </div>
        <div class="form-group">
           <label class="col-sm-2 control-label" for="textarea_newuser_message">
            <input type="checkbox" name="module_telnotification_newuser" {% if module_telnotification_newuser == 1 or module_telnotification_newuser == 'on' %}value="1" checked{% else %}value="0"{% endif %}>
           {{ textarea_newuser_label }}</label>
           <div class="col-sm-10">
             <p>{{textarea_newuser_description}}</p>
             <textarea type="text" name="module_telnotification_newuser_message" style="height: 200px;" placeholder="{{ textarea_newuser_example }}" id="textarea_newuser_message" class="form-control">{{module_telnotification_newuser_message}}</textarea>
           </div>
         </div>
        <div class="form-group">
           <label class="col-sm-2 control-label" for="textarea_contact_message">
            <input type="checkbox" name="module_telnotification_contact" {% if module_telnotification_contact == 1 or module_telnotification_contact == 'on' %}value="1" checked{% else %}value="0"{% endif %}>
           {{ textarea_contact_label }}</label>
           <div class="col-sm-10">
             <p>{{textarea_contact_description}}</p>
             <textarea type="text" name="module_telnotification_contact_message" style="height: 200px;" placeholder="{{ textarea_contact_example }}" id="textarea_contact_message" class="form-control">{{module_telnotification_contact_message}}</textarea>
           </div>
         </div>
        <div class="form-group">
           <label class="col-sm-2 control-label" for="textarea_orderstatus_message">
            <input type="checkbox" name="module_telnotification_orderstatus" {% if module_telnotification_orderstatus == 1 or module_telnotification_orderstatus == 'on' %}value="1" checked{% else %}value="0"{% endif %}>
           {{ textarea_orderstatus_label }}</label>
           <div class="col-sm-10">
             <p>{{textarea_orderstatus_description}}</p>
             <textarea type="text" name="module_telnotification_orderstatus_message" style="height: 200px;" placeholder="{{ textarea_orderstatus_example }}" id="textarea_orderstatus_message" class="form-control">{{module_telnotification_orderstatus_message}}</textarea>
           </div>
         </div>
        <div class="form-group">
           <label class="col-sm-2 control-label" for="textarea_pricelevel_message">
            <input type="checkbox" name="module_telnotification_pricelevel" {% if module_telnotification_pricelevel == 1 or module_telnotification_pricelevel == 'on' %}value="1" checked{% else %}value="0"{% endif %}>
           {{ textarea_pricelevel_label }}</label>
           <div class="col-sm-10">
             <p>{{textarea_pricelevel_description}}</p>
             <textarea type="text" name="module_telnotification_pricelevel_message" style="height: 200px;" placeholder="{{ textarea_pricelevel_example }}" id="textarea_pricelevel_message" class="form-control">{{module_telnotification_pricelevel_message}}</textarea>
           </div>
         </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
  let count = {{count}}

  function addRecipient(){
    count=count +1;
    console.log(count);

    html = `<tr id="recipient${count}">`;
    html +=   `<td class="text-left">`;
    html +=     `<input type="text" name="module_telnotification_recipients[${count}][name]" value="" placeholder="{{text_recipient_placeholder_name}}">`;
    html +=   `</td>`;
    html +=   `<td class="text-left">`;
    html +=     `<input type="text" name="module_telnotification_recipients[${count}][id]" value="" placeholder="{{text_recipient_placeholder_id}}">`;
    html +=   `</td>`;
    html +=   `<td class="text-left"><button type="button" onclick="$('#recipient${count}, .tooltip').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>`;
    html += `</tr>`;

    $('#recipients tbody').append(html);
  }

  $('input[type=checkbox]').click(function(e) {
    setTimeout( () => {
      if ($(this).prop('checked')) {
        $(this).val('1');
      } else {
        $(this).val('0');
      }
    }, 100)
  });

</script>
{{ footer }}