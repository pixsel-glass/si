{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li>
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
          <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        </div>
      {% endif %}
      {% if success %}
        <div class="alert alert-success alert-dismissible">
          <i class="fa fa-check-circle"></i> {{ success }}
        </div>
      {% endif %}

      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_pixsel_parser_status" id="input-status" class="form-control">
                <option value="1" {{ module_pixsel_parser_status == 1 ? 'selected="selected"' : '' }}>{{ text_enabled }}</option>
                <option value="0" {{ module_pixsel_parser_status == 0 ? 'selected="selected"' : '' }}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-feed-iterations">{{ entry_feed_iterations }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_pixsel_parser_iterations" value="{{ module_pixsel_parser_iterations }}" placeholder="{{ entry_feed_iterations }}" id="input-feed-iterations" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-feed-login">{{ entry_feed_login }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_pixsel_parser_login" value="{{ module_pixsel_parser_login }}" placeholder="{{ entry_feed_login }}" id="input-feed-login" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-feed-password">{{ entry_feed_password }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_pixsel_parser_password" value="{{ module_pixsel_parser_password }}" placeholder="{{ entry_feed_password }}" id="input-feed-password" class="form-control" />
            </div>
          </div>

          {% if cron_command %}
          <div class="form-group">
           <label class="col-sm-2 control-label" for="input-feed-password">{{ entry_feed_cron }}</label>
              <div class="col-sm-10">
                  <input type="text" value="{{cron_command}}" readonly class="form-control" />
              </div>
          </div>
          {% endif %}


          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-feed-url">{{ entry_feed_url }}</label>
            <div class="col-sm-10">
              <input type="url" name="module_pixsel_parser_feed_url" value="{{ module_pixsel_parser_feed_url }}" placeholder="{{ entry_feed_url }}" id="input-feed-url" class="form-control" />
            </div>
          </div>

          <div class="form-group container-fluid">
            <h4>{{ entry_prefix }}</h4>
            {% for language in languages %}
              <div class="row">
                <label class="col-sm-2 control-label" for="input-prefix-{{ language.code }}"><img src="language/{{ language.code }}/{{ language.code }}.png" alt="{{ language.name }}" title="{{ language.name }}" /> {{ language.name }}</label>
                <div class="col-sm-10">
                  {% set prefix = module_pixsel_parser_prefixes[language.code] is defined ? module_pixsel_parser_prefixes[language.code] : '' %}
                  <input type="text" name="module_pixsel_parser_prefixes[{{ language.code }}]" value="{{ prefix }}" placeholder="{{ entry_prefix }}" id="input-prefix-{{ language.code }}" class="form-control" />
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="form-group ">
            {# <div class="row"> #}
              <label class="col-sm-2 control-label" for="input-feed-url">{{ entry_option }}</label>
              <div class="col-sm-10">
                <select class="form-control" id="options-select" name="module_pixsel_parser_option">
                  <option value="">{{text_no_select}}</option>
                  {% for option in options %}
                    <option value="{{ option.option_id }}" {% if module_pixsel_parser_option == option.option_id %} selected {% endif %}>{{ option.name }}</option>
                  {% endfor %}
                </select>
                <div id="options-select-msg" style="font-weight: 700; color: red;"></div>
              </div>
            {# </div> #}
          
          </div>
        
           <div class="form-group">
             {% if option_values %}
                  {% for value in option_values %}
                      <label class="col-sm-2 control-label" for="input-option-value-{{ value.option_value_id }}">{{ value.name }}</label>
                      <div class="col-sm-10">
                         <input type="text" class="form-control" id="input-option-value-{{ value.option_value_id }}" name="module_pixsel_parser_option_variants[{{ value.option_value_id }}]" value="{% if module_pixsel_parser_option_variants[value.option_value_id] %}{{ module_pixsel_parser_option_variants[value.option_value_id] }}{% endif %}" />
                      </div>
                  {% endfor %}
              {% endif %}
          </div>


          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-feed-url">{{ entry_category }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_pixsel_parser_main_category" value="{{module_pixsel_parser_main_category}}" placeholder="{{ entry_category_placeholder }}" id="input-category" class="form-control" />
              <input type="hidden" name="module_pixsel_parser_main_category_id" value="{{module_pixsel_parser_main_category_id}}" />
            </div>
          </div>


        </form>

        <div class="form-group text-right">
          <div id="import-msg"></div>
          <button type="button" id="delete-button" class="btn btn-danger"><i class="fa fa-remove"></i> {{ button_delete }}</button>
          <button type="button" id="import-button" class="btn btn-warning"><i class="fa fa-download"></i> {{ button_import }}</button>
          <br />
          <br />
          <div class="progress">
            <div id="import-progress-bar" class="progress-bar progress-bar-striped bg-success" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
          </div>
          <div id="import-result" style="text-align: left;">
            <div class="info"></div>
            <div class="product"></div>
            <div class="cat"></div>
          </div>
        </div>


        <div class="form-group">
          <textarea rows="10" class="form-control" disabled>{{ logData }}</textarea>
        </div>

      </div>
    </div>
  </div>
</div>
{{ footer }}


<script type="text/javascript">

$('input[name=\'module_pixsel_parser_main_category\']').autocomplete({
    'source': function(request, response) {
        $.ajax({
            url: 'index.php?route=extension/module/pixsel_parser/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
            dataType: 'json',
            success: function(json) {
                var data = $.map(json, function(item) {
                    return {
                        label: item['name'],
                        value: item['category_id']
                    };
                });
                data.unshift({
                    label: "{{entry_category_placeholder}}",
                    value: '0'
                });

                response(data);
            }
        });
    },
    'select': function(item) {
        $('input[name=\'module_pixsel_parser_main_category\']').val(item['label']);
        $('input[name=\'module_pixsel_parser_main_category_id\']').val(item['value']);
    }
});
</script>


<script type="text/javascript">

    var dataStatus = {
      category: {
        updated: 0,
        created: 0,
        deleted: 0,
      },
      product: {
        updated: 0,
        created: 0,
        deleted: 0,
      }
    };

     const originalOption = $('#options-select').val();

      $('#options-select').change(function() {
        const selectedOption = $(this).val();
        console.log(selectedOption);
        console.log(originalOption);
       
        if (selectedOption !== originalOption) {
          $('#options-select-msg').text("{{text_save_change_option}}");
        }else{
          $('#options-select-msg').text('');
        }
    });

    function import_process($btn, offset, type) {
      $.ajax({
         url: 'index.php?route=extension/module/pixsel_parser/importData&user_token={{ user_token }}',
         type: 'POST',
         data: {
          offset: offset,
          type: type
         },
         beforeSend: function() {
          // $btn.button('loading');
         },
        success: function(response) {
          if(response.error){
            $('#import-msg').prepend(response.error);
            $btn.button('reset');
          }
          if(response.complete){
            
            if(response.complete.type == 'categories'){
                 dataStatus.category.created += response.complete.created;
                 dataStatus.category.updated += response.complete.updated;
                 dataStatus.category.deleted += response.complete.deleted;
              $('#import-result .cat').html('<div>Categories Created: ' + dataStatus.category.created + '</div>' +
                                 '<div>Categories Updated: ' + dataStatus.category.updated + '</div>' +
                                 '<div>Categories Deleted: ' + dataStatus.category.deleted + '</div>');
            }

              if(response.complete.type == 'products'){
              dataStatus.product.created += response.complete.created;
              dataStatus.product.updated += response.complete.updated;
              dataStatus.product.deleted += response.complete.deleted;
              $('#import-result .product').html('<div style="padding-top: 10px; margin-top: 10px; border-top: 2px dashed #ddd;">Products Created: ' + dataStatus.product.created + '</div>' +
                                 '<div>Products Updated: ' + dataStatus.product.updated + '</div>' +
                                 '<div style="padding-bottom: 10px; margin-bottom: 10px; border-bottom: 2px dashed #ddd;">Products Deleted: ' + dataStatus.product.deleted + '</div>');
            }
            
            $('#import-progress-bar').css({width: '100%'}).html('100%');

             if(response.complete.next && response.complete.next == 'products'){
              $('#import-result .info').html('{{text_import_products_pre}}');
              setTimeout(function() {
                import_process($btn, 0, response.complete.next);
              }, 3000);
             }
          }
          if(response.process){
            
            if(response.process.type == 'categories'){
              dataStatus.category.created += response.process.created;
              dataStatus.category.updated += response.process.updated;
              $('#import-result .cat').html('<div>Categories Created: ' + dataStatus.category.created + '</div>' +
                                 '<div>Categories Updated: ' + dataStatus.category.updated + '</div>' +
                                 '<div>Categories Deleted: ' + dataStatus.category.deleted + '</div>');
            }
            
            if(response.process.type == 'products'){
              dataStatus.product.created += response.process.created;
              dataStatus.product.updated += response.process.updated;
              $('#import-result .info').html('{{text_import_products}}' + ' {{text_import_all}}' + response.process.all);
              $('#import-result .product').html('<div style="padding-top: 10px; margin-top: 10px; border-top: 2px dashed #ddd;">Products Created: ' + dataStatus.product.created + '</div>' +
                                 '<div>Products Updated: ' + dataStatus.product.updated + '</div>' +
                                 '<div style="padding-bottom: 10px; margin-bottom: 10px; border-bottom: 2px dashed #ddd;">Products Deleted: ' + dataStatus.product.deleted + '</div>');
            }

            var percentage = parseFloat(((response.process.offset / response.process.all) * 100).toFixed(2));
            $('#import-progress-bar').css({width: percentage + '%'}).html(percentage + '%');
            import_process($btn, response.process.offset, response.process.type);
          }
          if(response.success){
            $('#import-result .info').html('{{text_import_success}}');
            $btn.button('reset');
            logger_pixsel_import(dataStatus);
          }
        },
        complete: function() {
          // $btn.button('reset');
        }
      });
    }


    function logger_pixsel_import(data) {
      $.ajax({
        url: 'index.php?route=extension/module/pixsel_parser/logger&user_token={{ user_token }}',
        type: 'POST',
        data: data,
        success: function () {

        },
      });
    }


 $('#delete-button').on('click', function() {

   if(!confirm('Are you sure you want to delete')){
     return;
   }

   var $btn = $(this);
        $.ajax({
            url: 'index.php?route=extension/module/pixsel_parser/deleteAllData&user_token={{ user_token }}',
            type: 'GET',
            beforeSend: function() {
              $btn.button('loading');
            },
            success: function(response) {
                if(response.error){
                  $('#import-result .info').html(response.error);
                }
                if(response.success){
                  $('#import-result .info').prepend('{{text_all_deleted}}');
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Error: ' + thrownError);
            },
            complete: function() {
              $btn.button('reset');
            }
        });
 });

    $('#import-button').on('click', function() {
      var $btn = $(this);
        $.ajax({
            url: 'index.php?route=extension/module/pixsel_parser/importData&user_token={{ user_token }}',
            type: 'GET',
            beforeSend: function() {
              $btn.button('loading');
            },
            success: function(response) {
                if(response.debug){
                  $('#import-result').html('<pre>' + JSON.stringify(response.debug, null, 2) + '</pre>');
                }
                if(response.error){
                  $('#import-msg').html(response.error);
                }
                if(response.complete){
                  $('#import-result').prepend(JSON.stringify(response.complete, null, 2));
                }
                if(response.process){

                  $('#import-result .info').html('{{text_import_categories}}' + ' {{text_import_all}}' + response.process.all);
                  dataStatus.category.created += response.process.created;
                  dataStatus.category.updated += response.process.updated;
                   $('#import-result .cat').html('<div>Categories Created: ' + dataStatus.category.created + '</div>' +
                              '<div>Categories Updated: ' + dataStatus.category.updated + '</div>' +
                              '<div>Categories Deleted: ' + dataStatus.category.deleted + '</div>');

                  var percentage = parseFloat(((response.process.offset / response.process.all) * 100).toFixed(2));
                  $('#import-progress-bar').css({width: percentage + '%'}).html(percentage + '%');;
                  import_process($btn, response.process.offset, response.process.type);
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Error: ' + thrownError);
            },
            complete: function() {
              // $btn.button('reset');
            }
        });
    });
</script>
