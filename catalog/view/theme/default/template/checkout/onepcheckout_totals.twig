<div class="totals-inner">
	<div class="title-text-next">
		<span class="opc-cart-title">{{ text_you_order }}</span>
		{% if opc_show_weight is defined and opc_show_weight == 1 %}
			<span class="opc-cart-weight">{{ weight }}</span>
		{% endif %}
	</div>
	{% if type_customer is defined and type_customer == 2 %}
		<div class="select_client">
			<div class="form-group">
				<div class="top-find-client d-flex align-items-end">
					<label class="control-label opc-label mr-auto" for="input-select-client">{{ text_find_client }}</label>
					{% if client_id is defined %}
					<div id="add-retail-customer" data-customer-id="{{ retail_info['customer_id'] }}" data-customer-name="{{ retail_info['firstname'] }} {{ retail_info['lastname'] }} {{ retail_info['telephone'] }}" class="control-label opc-label ml-auto text-gray-500">{{ text_retail_customer }}</div>
					{% endif %}
					<button class="btn btn-default pl-0 pr-0 ml-2 box-shadow-off order-3" type="button" onclick="createCustomer();">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="butt" stroke-linejoin="bevel"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
					</button>
				</div>
				<div class="input-group">
					<input autocomplete="off" type="text" name="client_name_tel" value="{{ client_info }}" placeholder="{{ client_info_plc }}" id="input-select-client" class="form-control" />
					<input autocomplete="off" type="hidden" name="client_id" value="{{ client_id }}" id="input-client-id" class="form-control" />
					<span class="input-group-btn">
						<button id="button-remove-client" class="btn btn-light d-none">
							<svg class="d-block ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
							</svg>
						</button>
						<input type="submit" value="ok" id="button-add-client" class="btn btn-primary" />
					</span>
				</div>
			</div>
		</div>
	{% endif %}

	{% if  coupon_status  or  voucher_status  or  reward_status %}
	<div class="checkout-cart-accordion" id="accordion">
		<a href="#collapse-dop-module" class="text-checkout-modules accordion-toggle" data-toggle="collapse" data-parent="#accordion">{{ text_next }}
			<svg class="icon-arrow-down"><use xlink:href="catalog/view/javascript/opc/image/sprite.svg#icon-arrow-down"></use></svg>
		</a>
		<div id="collapse-dop-module" class="panel-collapse collapse pb-10">
		{% if coupon_status %}
			<div class="cart-coupon">
				<div class="form-group">
					<label class="control-label" for="input-coupon">{{ text_coupon }}</label>
					<div class="input-group">
						<input type="text" name="coupon" value="{{ coupon }}" placeholder="{{ entry_coupon }}" id="input-coupon" class="form-control" />
						<span class="input-group-btn">
							<input type="button" value="ok" id="button-coupon" class="btn btn-primary" />
						</span>
					</div>
				</div>
			</div>
		{% endif %}
		{% if voucher_status %}
			<div class="cart-voucher">
				<div class="form-group">
					<label class="control-label" for="input-voucher">{{ text_voucher }}</label>
					<div class="input-group">
						<input type="text" name="voucher" value="{{ voucher }}" placeholder="{{ entry_voucher }}" id="input-voucher" class="form-control" />
						<span class="input-group-btn">
							<input type="submit" value="ok" id="button-voucher" class="btn btn-primary" />
						</span>
					</div>
				</div>
			</div>
		{% endif %}
		{% if reward_status %}
			<div class="cart-reward">
				<div class="form-group">
					<label class="control-label" for="input-reward">{{ text_reward }}</label>
					<div class="input-group">
						<input type="text" name="reward" value="{{ reward }}" placeholder="{{ entry_reward }}" id="input-reward" class="form-control" />
						<span class="input-group-btn">
							<input type="submit" value="ok" id="button-reward" class="btn btn-primary" />
						</span>
					</div>
				</div>
			</div>
		{% endif %}
		</div>
	</div>
	{% endif %}
	<div class="checkout-totals">
		{% if free_shipping_status %}
			<div class="free-shipping-left">
				<div class="free-shipping-inner" data-fsl-width="{{ fs_percentage }}">
					<div class="free-ship-progress-bar{% if fs_percentage == 100 %} hidden{% endif %}">
						<div class="free-ship-bar-fill" style="width: {{ fs_percentage }}%"></div>
					</div>
					{% if fs_percentage < 100 %}
						<div class="free-ship-info">
							{{ text_free_shipping_left }}
						</div>
					{% else %}
						<div class="free-ship-info active-free-ship">{{ text_free_shipping }}</div>
					{% endif %}
				</div>
			</div>
		{% endif %}
		<table class="table table_total table-cart">
			{% for key,total in totals %}
				<tr>
					{% if total['value'] != 0 %}
						<td class="text-left total-title{% if (key+1 == totals|length) %} total-last{% endif %}">{{ total['title'] }}{% if pixsel_tax_status %} {{ lang_with }}{% endif %}:</td>
						<td class="text-right total-text">{{ total['text'] }}</td>
					{% endif %}
				</tr>
				{% if pixsel_tax_status and total.code == 'sub_total' %}
					<tr>
						{% if total['value'] != 0 %}
							<td class="text-gray-500 text-left total-title{% if (key+1 == totals|length) %} total-last{% endif %}">{{ total['title'] }} {% if pixsel_tax_status %} {{ lang_without }}{% endif %}:</td>
							<td class="text-gray-500 text-right total-text">{{ total['tax_text'] }}</td>
						{% endif %}
					</tr>
				{% endif %}
			{% endfor %}
		</table>
		<div class="opc-agree">
			{% if text_agree %}
				<div class="group-checkbox checkout-agree {% if type_customer == 2 %}d-none{% endif %}">
					<label class="chm-checkbox mb-0">
						{% if agree or (type_customer == 2) %}
							<input class="checkbox-input" type="checkbox" name="agree" value="1" checked="checked" />
						{% else %}
							<input class="checkbox-input" type="checkbox" name="agree" value="1" />
						{% endif %}
						<span class="checkbox-check"></span>{{ text_agree }}
					</label>
				</div>
			{% endif %}
			{% if opc_show_not_call_me is defined and opc_show_not_call_me == 1 %}
				<div class="group-checkbox checkout-agree">
					<label class="chm-checkbox mb-0">
						<input autocomplete="off" class="checkbox-input" type="checkbox" name="opc_not_call_me" value="1" {% if opc_not_call_me %}checked="checked"{% endif %} />
						<span class="checkbox-check"></span>{{ text_not_call_me }}
					</label>
				</div>
			{% endif %}
		</div>
		{% if type_customer is defined and type_customer == 2 %}
		<div class="opc-bezvat">
			<div class="group-checkbox checkout-agree">
				<label class="chm-checkbox mb-0">
					<input autocomplete="off" class="checkbox-input" type="checkbox" name="infakt_vat" value="1" {% if infakt_vat %}checked="checked"{% endif %} />
					<span class="checkbox-check"></span>{{ text_novat }}
				</label>
			</div>
		</div>
		{% endif %}
		{% if type_customer is defined and type_customer == 2 %}
			<div class="group-checkbox checkout-agree">
				<label class="chm-checkbox mb-0">
					<input class="checkbox-input" type="checkbox" name="opc_order_from_self" value="1" {% if opc_order_from_self %}checked="checked"{% endif %} />
					<span class="checkbox-check"></span>{{ text_opc_order_from_self }}
				</label>
			</div>
		{% endif %}
		<div class="confirm-block">
		{% if not payment %}
			<input type="button" class="opc-btn opc-btn-primary w-100" data-loading-text="{{ text_loading }}" data-text-btn-default="{{ button_checkout }}" id="button-register" value="{{ button_checkout }}">
		{% endif %}
		</div>
	</div>
</div>