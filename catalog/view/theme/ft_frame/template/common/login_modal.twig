function checkFirma(){
	var selectedValue = $('#register-data input[name="customer_type"]:checked').val();
	if (selectedValue == 1) {
		$('#register-data .firma_fields').removeClass('d-none');

		if ($('select[id="input-country"] option:selected').val() != 170 && $('select[id="input-country"] option:selected').val() != '') {
			$('input[name="company_nip"]').closest('.form-group').addClass('d-none');
			$('#button-nip').addClass('d-none');
			$('.cmvatcode').removeClass('d-none');

			if ($('select[name="country_id"] option:selected').val() > 0) {
				$('input[name="pl_company_name"]').removeClass('d-none');
				$('input[name="company_region"]').removeClass('d-none');
				$('input[name="company_address"]').removeClass('d-none');
				$('input[name="company_zip"]').removeClass('d-none');
			}
		} else {
			$('input[name="company_nip"]').closest('.form-group').removeClass('d-none');
			$('#button-nip').removeClass('d-none');
			$('.cmvatcode').addClass('d-none');

			if ($('select[name="country_id"] option:selected').val() > 0) {
				$('input[name="pl_company_name"]').addClass('d-none');
				$('input[name="company_region"]').addClass('d-none');
				$('input[name="company_address"]').addClass('d-none');
				$('input[name="company_zip"]').addClass('d-none');
			}
		}
	} else {
		$('#register-data .firma_fields').addClass('d-none');
	}
}
$(document).on('change', '#register-data input[name="customer_type"]', function () {
	checkFirma();
});

$(document).on('click', '#login-popup-account-view-button', function () {
	$('.sap-authorization-block').append( $('.sap-forgotten-block').contents() );
});

$(document).on('click', '#login-popup-forgotten-view-button', function () {
	$('.sap-forgotten-block').append( $('.sap-authorization-block').contents() );
});

function loading_mask(action){
	if (action) {
		if(!$('.loading_mask').length){
			$('body').append('<div class="loading_mask"></div>');
		}
		$('.loading_mask').html('<div class="center-body"><div class="opc-loader-circle"></div></div>');
		$('.loading_mask').show();
	} else {
		$('.loading_mask').html('');
		$('.loading_mask').hide();
	}
};

checkFirma();

$(document).on('keypress', '#pixsel-input-password, #login-data input[name="email"]', function(e) {
	if(e.which == 13) {
		$('#button-login-popup').trigger('click');
	}
});

$(document).on('click', '#button-login-popup', function(e) {
	var $btn = $('#button-login-popup');
   var originalText = $btn.text();
   $('#login-data .alert').remove();

	$.ajax({
		url: 'index.php?route=common/login_modal/login_validate',
		type: 'post',
		data: $('#login-data').serialize(),
		dataType: 'json',
		beforeSend: function() {
			loading_mask(true);
    		$btn.text($btn.attr('data-loading'));
		},
		complete: function() {
			$btn.text(originalText);
		},
		success: function(json) {

			if(json['islogged']){
				location.reload();
			}

			if (json['error']) {
				loading_mask(false);
				$('#login-data').prepend('<div class="alert alert-danger alert-dismissible mt-4 mb-4">' + json['error'] + ' <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button></div>');
			}

			setTimeout(function () {
				$('#login-data .alert').remove();
			}, 3000);

			if(json['success']){
				self.loading_mask(false);
				$('#ft-login-modal').modal('hide');
				// location.reload();
				// lm_setCookie('languageauto', '1', {expires: 180});
				if (json['language_id']) {
					$('button[data-lang-id="'+json['language_id']+'"]').trigger('click');
				} else {
					window.location = window.location;
				}
				// window.location = window.location;
			}

		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$(document).on('click', '#button-register-popup', function(e) {
	var $btn = $('#button-register-popup');
   	var originalText = $btn.text();

	$.ajax({
		url: 'index.php?route=common/login_modal/register_validate',
		type: 'post',
		data: $('#register-data').serialize(),
		dataType: 'json',
		beforeSend: function() {
    		$btn.text($btn.attr('data-loading'));
		},
		complete: function() {
			$btn.text(originalText);
		},
		success: function(json) {

			if (json['error']) {
				$('#register-data').prepend('<div class="alert alert-danger alert-dismissible mt-4 mb-4">' + json['error'] + ' <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button></div>');
			}

			setTimeout(function () {
				$('#register-data .alert').remove();
			}, 3000);

			if(json['success']){
				$('#register-data').prepend('<div class="alert alert-success alert-dismissible mt-4 mb-4">' + json['success'] + ' <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button></div>');
				setTimeout(function () {
					$('#ft-login-modal').modal('hide');
					location.reload();
				}, 1500);
			}

		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

