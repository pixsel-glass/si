      {% if orders %}
      <div class="table-responsive">
        <table class="table table-bordered table-hover manager-table">
          <thead>
            <tr class="bg-light">
              <th class="text-center pt-2 pb-2 pl-1 pr-1">{{ column_order_id }}</th>
              <th class="text-center pt-2 pb-2 pl-1 pr-1 d-md-table-cell">{{ column_customer }}</th>
              <th class="text-center pt-2 pb-2 pl-1 pr-1 d-md-table-cell">{{ column_country }}</th>
              <th class="text-center pt-2 pb-2 pl-1 pr-1">{{ column_product }}</th>
              <th class="text-center pt-2 pb-2 pl-1 pr-1">{{ column_status }}</th>
              <th class="text-center pt-2 pb-2 pl-1 pr-1 d-md-table-cell">
                {{ column_total }}
                {% if pixsel_tax_status %}
                  <span class="text-gray-500 font-weight-normal">{{ lang_with }}</span>
                {% endif %}
              </th>
              <th class="text-center pt-2 pb-2 pl-1 pr-1 d-md-table-cell">{{ column_date_added }}</th>
              <th class="text-center pt-2 pb-2 pl-1 pr-1"><span class="d-md-block">{{ column_order_info }}</span></td>
            </tr>
          </thead>
          <tbody>
           {% for order in orders %}
            <tr {% if order.customer_id == 0 %}style="background-color: #f5f3f3;"{% endif %}>
              <td class="text-center p-2">
                #{{ order.order_id }}
              </td>
              <td class="text-center p-2 d-md-table-cell">
                {{ order.name }}
                {% if order.customer_id == 0 %}
                  <div class="d-block noauth text-muted">
                    {{ text_noauth }}
                  </div>
                {% endif %}
              </td>
              <td class="text-center p-2 d-md-table-cell">{{ order.country }}</td>
              <td class="text-center p-2">{{ order.products }}</td>
              <td class="text-center p-2">
                  {% for order_status in order_statuses %}
                    {% if order.order_status_id == order_status.order_status_id %}
                    <div class="order-status">
                      <input type="text" id="input-order-status" name="order_status" value="{{ order_status.name }}" data-orderid="{{ order.order_id }}" class="form-control" disabled="disabled" data-bg="{{ order_status.jclr_bg }}" data-co="{{ order_status.jclr_text }}" style="text-align: center; background-color: {{ order_status.jclr_bg }}; color: {{ order_status.jclr_text }};"> 
                      <a href="#" data-orderid="{{ order.order_id }}" data-toggle="modal" data-target="#editStatusModal" class="editStatusModal" style="float: right;"><i class="fa fa-pencil"></i></a>
                    </div>
                    {% endif %}
                  {% endfor %}
              </td>
              <td class="text-center p-2 d-md-table-cell">
                <span class="text-nowrap">{{ order.total }}</span>
                {% if pixsel_tax_status %}
                  <span class="netto-price d-inline-block">{{ order.tax_total }} {{ lang_without }}</span>
                {% endif %}
                {% if order.payed == 1 %}
                  <span class="payed d-block">{{ entry_spayed }}{% if order.payed_with is not empty %} <span class="text-muted font-size-12">({{ order.payed_with }})</span>{% endif %}</span>
                {% endif %}
              </td>
              <td class="text-center p-2 d-md-table-cell">{{ order.date_added }}</td>
              <td class="text-center p-2">{# href="{{ order.view }}" #}
                <button onclick="orderInfo({{ order.order_id }})" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-info">
									<svg class="d-block ft-icon-10 m-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
									</svg>
							  </button>
                <button onclick="orderEdit({{ order.order_id }})" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-danger">
                  <svg fill="#ffffff" height="11px" width="11px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 306.637 306.637" xml:space="preserve" stroke="#ffffff"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <path d="M12.809,238.52L0,306.637l68.118-12.809l184.277-184.277l-55.309-55.309L12.809,238.52z M60.79,279.943l-41.992,7.896 l7.896-41.992L197.086,75.455l34.096,34.096L60.79,279.943z"></path> <path d="M251.329,0l-41.507,41.507l55.308,55.308l41.507-41.507L251.329,0z M231.035,41.507l20.294-20.294l34.095,34.095 L265.13,75.602L231.035,41.507z"></path> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> <g> </g> </g> </g></svg>
                </button>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="row">
        <div class="col-sm-6 text-left">{{ pagination }}</div>
        <div class="col-sm-6 text-right">{{ results }}</div>
      </div>
      {% else %}
      <p>{{ text_empty }}</p>
      {% endif %}