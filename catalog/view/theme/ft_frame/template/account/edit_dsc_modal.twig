<div class="modal-dialog modal-dialog-center modal-lg">
	<div class="modal-content border-0 rounded-lg mh-100 h-100">
		<div class="modal-header no-gutters">
			<div class="col">
				<div class="h5 modal-title">{{ text_your_details }}</div>
			</div>
			<div class="col-auto">
            <a href="#" class="d-block ml-2" data-dismiss="modal">
        			<svg class="d-block ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        				<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
        			</svg>
        		</a>
			</div>
		</div>
		<div class="modal-body dscmodal p-4">
			<form method="post" autocomplete="off" id="form-edit-default-fileds" enctype="multipart/form-data" class="form-horizontal edit-dsc-modal">
				<ul class="nav nav-tabs">
					<li class="nav-item">
    					<a class="nav-link active" data-toggle="tab" href="#infoMain">{{ entry_tab_main }}</a>
  					</li>
  					<li class="nav-item {% if customer_type == 3 %}d-none{% endif %}">
    					<a class="nav-link" data-toggle="tab" href="#infoDefault">{{ entry_tab_default }}</a>
  					</li>
  				</ul>

  				<div class="tab-content">
  					<div class="tab-pane active in" id="infoMain">
  						<h5>{{ text_your_details }}</h5>
  						<div>
  							{% if customer_type != 2 %}
							<div class="form-group d-flex">
	        					<label class="col-3 text-left mb-0 pl-0 pt-2" for="input-customer-group">{{ entry_customer_group }}</label>
								<div class="col-9 col-sm-7">
									<select name="customer_group_id" id="input-customer-group" class="form-control">
									{% for customer_group in customer_groups %}
									{% if customer_group.customer_group_id == customer_group_id %}
									<option value="{{ customer_group.customer_group_id }}" selected="selected">{{ customer_group.name }}</option>
									{% else %}
									<option value="{{ customer_group.customer_group_id }}">{{ customer_group.name }}</option>
									{% endif %}
									{% endfor %}
								 	</select>
								</div>
							</div>
							{% endif %}

					        {% if customer_type != 2 %}
					          <div class="form-group">
					            <div class="form-check form-check-inline">
					              <label class="form-check-label">
					                {% if customer_type == 0 %}
					                  <input autocomplete="off" class="form-check-input" type="radio" name="customer_type" value="0" checked="checked" />
					                  {{ text_customer_private }}
					                {% else %}
					                  <input autocomplete="off" class="form-check-input" type="radio" name="customer_type" value="0" />
					                  {{ text_customer_private }}
					                {% endif %}
					              </label>
					            </div>
					            <div class="form-check form-check-inline">
					              <label class="form-check-label"> {% if customer_type == 1 %}
					                <input autocomplete="off" class="form-check-input" type="radio" name="customer_type" value="1" checked="checked" />
					                {{ text_customer_firma }}
					              {% else %}
					                <input autocomplete="off" class="form-check-input" type="radio" name="customer_type" value="1" />
					                {{ text_customer_firma }}
					              {% endif %}
					            </label>
					          </div>
					          {% if customer_type == 2 %}
					            <div class="form-check form-check-inline">
					              <label class="form-check-label"> {% if customer_type == 2 %}
					                <input autocomplete="off" class="form-check-input" type="radio" name="customer_type" value="2" checked="checked" />
					                {{ text_customer_worker }}
					              {% else %}
					                <input autocomplete="off" class="form-check-input" type="radio" name="customer_type" value="2" />
					                {{ text_customer_worker }}
					              {% endif %}
					            </label>
					          </div>
					          {% endif %}
					            {#<div class="form-check form-check-inline">
					              <label class="form-check-label">
								  {% if customer_type == 3 %}
					                <input autocomplete="off" class="form-check-input" type="radio" name="customer_type" value="3" checked="checked" />
					                {{ text_customer_nip }}
					              {% else %}
					                <input autocomplete="off" class="form-check-input" type="radio" name="customer_type" value="3" />
					                {{ text_customer_nip }}
					              {% endif %}
					              </label>
					            </div>#}
					        </div>
					        {% endif %}

							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 mb-0 pt-2" for="input-country">{{ entry_country }} </label>
								<div class="col-9 col-sm-7">
					                <select autocomplete="off" class="form-control" name="country_id" id="input-country" {% if customer_type == 3 %}readonly="readonly"{% endif %}>
					                  <option value="">{{ entry_country }}</option>
					                  {% for country in countries %}
									  <option value="{{ country.country_delivery_id }}" data-zone="{{ country.geo_zone_id }}" {% if country_id == country.country_delivery_id %}selected="selected"{% endif %}>{{ country.name }}</option>
					                  {% endfor %}
					                </select>
				              </div>
				            </div>

					        {% if customer_type != 2 %}
							<div class="firma_fields mt-3 {% if customer_type == 0 %}d-none{% endif %}">
					          <div class="form-group d-flex">
					            <label class="col-3 text-left mb-0 pl-0 pt-2" for="input-company-name">{{ entry_company_name }}</label>
					            <div class="col-9 col-sm-7">
					                <input autocomplete="off" type="text" name="company_name" value="{{ company_name }}" placeholder="{{ entry_company_name }}" id="input-company-name" class="form-control" />
					            </div>
					          </div>
					            <div class="form-group cmvatcode {% if country_id == 0 or country_id == 170 %}d-none{% else %}d-flex{% endif %}">
					              <label class="col-3 text-left mb-0 pl-0 pt-2" for="input-company-vatcode">{{ entry_company_vatcode }}</label>
					              <div class="col-9 col-sm-7">
					                <div class="input-group">
					                  <input autocomplete="off" type="text" name="company_vatcode" value="{{ company_vatcode }}" placeholder="{{ entry_company_vatcode }}" id="input-company-vatcode" class="form-control" />
					                </div>
					              </div>
					           	</div>
					          <div class="firma_other_fields {% if country_id != 0 and country_id != 170 %}d-none{% endif %}">
					            <div class="form-group d-flex">
					              <label class="col-3 text-left mb-0 pl-0 pt-2" for="input-company-nip">{{ entry_company_nip }}</label>
					              <div class="col-9 col-sm-7">
					                <div class="input-group">
					                  <input autocomplete="off" type="text" name="company_nip" value="{{ company_nip }}" placeholder="{{ entry_company_nip }}" id="input-company-nip" class="form-control" />
					                  <span class="input-group-append">
					                    <button type="button" class="btn btn-primary">
					                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
					                    </button>
					                  </span>
					                </div>
					              </div>
					            </div>
					            <div class="form-group d-flex">
					              <label class="col-3 text-left mb-0 pl-0 pt-2" for="input-pl-company-name">{{ entry_pl_company_name }}</label>
					              <div class="col-9 col-sm-7">
					                <input autocomplete="off" type="text" name="pl_company_name" value="{{ pl_company_name }}" placeholder="{{ entry_pl_company_name }}" id="input-pl-company-name" class="form-control" />
					              </div>
					            </div>

					            <div class="form-group d-flex">
					              <label class="col-3 text-left mb-0 pl-0 pt-2" for="input-company-region">{{ entry_company_region }}</label>
					              <div class="col-9 col-sm-7">
					                <input autocomplete="off" type="text" name="company_region" value="{{ company_region }}" placeholder="{{ entry_company_region }}" id="input-company-region" class="form-control" />
					              </div>
					            </div>
					            <div class="form-group d-flex">
					              <label class="col-3 text-left mb-0 pl-0 pt-2" for="input-company-address">{{ entry_company_address }}</label>
					              <div class="col-9 col-sm-7">
					                <input autocomplete="off" type="text" name="company_address" value="{{ company_address }}" placeholder="{{ entry_company_address }}" id="input-company-address" class="form-control" />
					              </div>
					            </div>
					            <div class="form-group d-flex">
					              <label class="col-3 text-left mb-0 pl-0 pt-2" for="input-company-zip">{{ entry_company_zip }}</label>
					              <div class="col-9 col-sm-7">
					                <input autocomplete="off" type="text" name="company_zip" value="{{ company_zip }}" placeholder="{{ entry_company_zip }}" id="input-company-zip" class="form-control" />
					              </div>
					            </div>
					            <div class="form-group {% if customer_type == 3 %}d-none{% else %}d-flex{% endif %}">
					              <label class="col-3 text-left mb-0 pl-0 pt-2" for="input-company-region">{{ entry_invoice_banks }}</label>
					              <div class="col-9 col-sm-7 invoice_banks">
					                {% set row_bank = 0 %}
					                {% if (invoice_banks) %}
					                  {% for invoice_bank in invoice_banks %}
					                    <div style="margin-bottom:10px;" class="input-group invoice-banks-{{ row_bank }}">
					                      <input autocomplete="off" type="text" name="invoice_banks[{{ row_bank }}][text]" value="{{ invoice_bank['text'] }}" class="form-control" />
					                      <span class="input-group-append">
					                        <button type="button" class="btn btn-danger remove-invoice-bank">
					                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
					                        </button>
					                      </span>
					                    </div>
					                  {% set row_bank = row_bank + 1 %}
					                  {% endfor %}
					                {% endif %}
					                <button id="add-invoice-field" type="button" class="btn btn-primary">{{ button_add }}</button>
					              </div>
					            </div>
					          </div>
					        </div>
					        {% endif %}

							<div class="form-group required {% if customer_type == 3 %}d-none{% else %}d-flex{% endif %}">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-firstname">{{ entry_firstname }} </label>
								<div class="col-9 col-sm-7">
									<input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="form-control" />
									{% if error_firstname %}
										<div class="text-danger">{{ error_firstname }}</div>
									{% endif %}
								</div>
							</div>
							<div class="form-group required {% if customer_type == 3 %}d-none{% else %}d-flex{% endif %}">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-lastname">{{ entry_lastname }}</label>
								<div class="col-9 col-sm-7">
									<input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="form-control" />
									{% if error_lastname %}
										<div class="text-danger">{{ error_lastname }}</div>
									{% endif %}
								</div>
							</div>
							<div class="form-group required {% if customer_type == 3 %}d-none{% else %}d-flex{% endif %}">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-email">{{ entry_email }}</label>
								<div class="col-9 col-sm-7">
									<input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
									{% if error_email %}
										<div class="text-danger">{{ error_email }}</div>
									{% endif %}
								</div>
							</div>
							<div class="form-group required {% if customer_type == 3 %}d-none{% else %}d-flex{% endif %}">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-telephone">{{ entry_telephone }}</label>
								<div class="col-9 col-sm-7">
									<input type="tel" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control" />
									{% if error_telephone %}
										<div class="text-danger">{{ error_telephone }}</div>
									{% endif %}
								</div>
							</div>
							<div class="form-group required {% if customer_type == 3 %}d-none{% else %}d-flex{% endif %}">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-password">{{ entry_password }}</label>
								<div class="col-9 col-sm-7">
									<input type="password" name="password" value="" placeholder="{{ entry_password }}" id="input-password" class="form-control" />
									{% if error_password %}
										<div class="text-danger">{{ error_password }}</div>
									{% endif %}
								</div>
							</div>
							<div class="form-group required {% if customer_type == 3 %}d-none{% else %}d-flex{% endif %}">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-confirm">{{ entry_password_confirm }}</label>
								<div class="col-9 col-sm-7">
									<input type="password" name="confirm" value="" placeholder="{{ entry_password_confirm }}" id="input-confirm" class="form-control" />
									{% if error_confirm %}
										<div class="text-danger">{{ error_confirm }}</div>
									{% endif %}
								</div>
							</div>
  						</div>
  					</div>
  					<div class="tab-pane" id="infoDefault">
						<div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-status">{{ entry_status }}</label>
								<div class="col-9">
									<div class="chm-form-check">
										<input autocomplete="off" type="hidden" name="dsc_status" value="0"/>
										<input autocomplete="off" type="checkbox" name="dsc_status" value="1" id="dsc_status" class="cm-toggle"{% if dsc_status %} checked{% endif %}/>
									</div>
								</div>
							</div>
							<div class="dsc-fileds {% if not dsc_status %}disabled-fields{% endif %}">
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-shipping-method">{{ entry_country }}</label>
								<div class="col-9">
									<select autocomplete="off" class="form-control" name="dsc_country" id="input-dsc-country">
										<option value="">{{ text_select }}</option>
										{% for country in countries %}
											<option value="{{ country.country_delivery_id }}" data-zone="{{ country.geo_zone_id }}" {% if dsc_country == country.country_delivery_id %}selected="selected"{% endif %}>{{ country.name }}</option>
											{#<option {% if dsc_country == country.country_id %}selected="selected"{% endif %} value="{{ country.country_id }}" data-zone="{{ country.geo_zone_id }}">{{ country.name }}</option>#}
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group d-flex dscvat {% if dsc_country == 170 or not dsc_status %}hidden{% endif %}">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-vat">{{ entry_vat }}</label>
								<div class="col-9">
									<div class="chm-form-check">
										<input autocomplete="off" type="hidden" name="dsc_vat" value="0"/>
										<input autocomplete="off" type="checkbox" name="dsc_vat" value="1" id="dsc_vat" class="cm-toggle"{% if dsc_vat == 1 %} checked{% endif %}/>
									</div>
								</div>
							</div>
							<div class="form-group d-none">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-currency">{{ entry_currency }}</label>
								<div class="col-9">
									<select autocomplete="off" class="form-control" name="dsc_currency" id="input-dsc-currency">
										<option value="">{{ text_select }}</option>
										{% for currency in currencies %}
											<option {% if dsc_currency == currency.code %}selected="selected"{% endif %} value="{{ currency.code }}" data-zone="{% if currency.currency_id == 1 %}6{% else %}0{% endif %}">{{ currency.code }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-language">{{ entry_language }}</label>
								<div class="col-9">
									<select autocomplete="off" class="form-control" name="dsc_language" id="input-dsc-language">
										<option value="">{{ text_select }}</option>
										{% for language in languages %}
											<option {% if dsc_language == language.code %}selected="selected"{% endif %} value="{{ language.code }}" data-lnid="{{ language.language_id }}">{{ language.name }}</option>
										{% endfor %}
									</select>
									<input autocomplete="off" type="hidden" name="language_id" value="{{ language_id }}"/>
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-firstname">{{ entry_firstname }} </label>
								<div class="col-9">
									<input type="text" name="dsc_firstname" value="{{ dsc_firstname }}" placeholder="{{ entry_firstname }}" id="input-dsc-firstname" class="form-control" />
									{% if error_firstname %}
										<div class="text-danger">{{ error_firstname }}</div>
									{% endif %}
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-lastname">{{ entry_lastname }}</label>
								<div class="col-9">
									<input type="text" name="dsc_lastname" value="{{ dsc_lastname }}" placeholder="{{ entry_lastname }}" id="input-dsc-lastname" class="form-control" />
									{% if error_lastname %}
										<div class="text-danger">{{ error_lastname }}</div>
									{% endif %}
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-telephone">{{ entry_telephone }}</label>
								<div class="col-9">
									<input type="tel" name="dsc_telephone" value="{{ dsc_telephone }}" placeholder="{{ entry_telephone }}" id="input-dsc-telephone" class="form-control" />
									{% if error_telephone %}
										<div class="text-danger">{{ error_telephone }}</div>
									{% endif %}
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-shipping-method">{{ entry_shipping_method }}</label>
								<div class="col-9">
									<select autocomplete="off" class="form-control" name="dsc_shipping_method" id="input-dsc-shipping-method">
										<option value="" data-zone="6">{{ text_select }}</option>
										{% for shhiping in shipping_methods %}
											<option {% if dsc_shipping_method == shhiping.code %}selected="selected"{% endif %} value="{{ shhiping.code }}" data-zone="{{ shhiping.geo_zone_id }}">{{ shhiping.title }}</option>
										{% endfor %}
									</select>
									<input type="hidden" name="parcelLocker" class="parcel-locker-value" value="{{ parcelLocker }}"><input type="hidden" name="parcelAddressLocker" class="parcel-addresslocker-value" value='{{ parcelAddressValLocker }}'>
									<div class="inpost_address" {% if hidden_packomat == 1 %}hidden{% endif %} style="cursor: pointer;">{{ parcelAddressLocker }}{% if parcelAddressLocker is empty %}{% else %}<svg fill="#000000" style="margin-left: 5px; width: 28px;" width="24px" height="24px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M11.707,5.293A1,1,0,0,1,11,7H4V17H9a1,1,0,0,1,0,2H3a1,1,0,0,1-1-1V6A1,1,0,0,1,3,5H8.586L7.293,3.707A1,1,0,1,1,8.707,2.293ZM21,5H15a1,1,0,0,0,0,2h5V17H13a1,1,0,0,0-.707,1.707l3,3a1,1,0,0,0,1.414-1.414L15.414,19H21a1,1,0,0,0,1-1V6A1,1,0,0,0,21,5Z"></path></g></svg>{% endif %}</div>
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-payment-method">{{ entry_payment_method }}</label>
								<div class="col-9">
									<select autocomplete="off" class="form-control" name="dsc_payment_method" id="input-dsc-payment-method">
										<option value="" data-zone="6">{{ text_select }}</option>
										{% for payment in payment_methods %}
											<option {% if dsc_payment_method == payment.code %}selected="selected"{% endif %} value="{{ payment.code }}" data-zone="{{ payment.geo_zone_id }}">{{ payment.title }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-city">{{ entry_city }}</label>
								<div class="col-9">
									<input autocomplete="off" type="text" name="dsc_city" value="{{ dsc_city }}" placeholder="{{ entry_city }}" id="input-dsc-city" class="form-control" />
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-address-1">{{ entry_address_1 }}</label>
								<div class="col-9">
									<input autocomplete="off" type="text" name="dsc_address_1" value="{{ dsc_address_1 }}" placeholder="{{ entry_address_1 }}" id="input-dsc-address-1" class="form-control" />
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-postcode">{{ entry_postcode }} </label>
								<div class="col-9">
									<input type="text" name="dsc_postcode" value="{{ dsc_postcode }}" placeholder="{{ entry_postcode }}" id="input-dsc-postcode" class="form-control" />
								</div>
							</div>
							<div class="form-group d-flex">
								<label class="col-3 text-left pl-0 pr-0 mb-0 pt-2" for="input-dsc-opc-not-call-me">{{ entry_not_call_me }}</label>
								<div class="col-9">
									<select autocomplete="off" class="form-control" name="dsc_opc_not_call_me" id="input-dsc-opc-not-call-me">
										<option {% if not dsc_opc_not_call_me or dsc_opc_not_call_me == 0 %}selected="selected"{% endif %} value="0">{{ text_disabled }}</option>
