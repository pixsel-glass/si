<div class="modal-dialog modal-dialog-center modal-lg">
  <div class="modal-content border-0 rounded-lg mh-100 h-100">
    
    <div class="modal-header no-gutters">
      <div class="col">
        <div class="h5 modal-title">{{ ostatus_title }}</div>
      </div>
      <div class="col-auto">
            <a href="#" class="d-block ml-2" data-dismiss="modal">
              <svg class="d-block ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
              </svg>
            </a>
      </div>
    </div>
    <div class="modal-body dscmodal p-4">
      <input class="checkbox-input" type="hidden" name="order_id" value="{{ order_id }}">

                  {# <select id="input-order-status" name="order_status" data-orderid="{{ order.order_id }}" class="form-control" disabled="disabled" style="margin: 0 auto;">
                    {% for order_status in order_statuses %}
                      {% if order_status.order_status_id != 15 %}
                        <option value="{{ order_status.order_status_id }}" {% if order.order_status_id == order_status.order_status_id %}selected="selected"{% endif %} data-bg="{{ order_status.jclr_bg }}" data-co="{{ order_status.jclr_text }}" style="background-color: {{ order_status.jclr_bg }}; color: {{ order_status.jclr_text }};">{{ order_status.name }}</option>
                      {% endif %}
                    {% endfor %}
                  </select> #}
      <div class="col-5" style="margin: 0 auto;">
        {# {% if order_status_id == 15 %}
          {% for order_status in order_statuses %}
            {% if order_status_id == 15 %}
              <div class="group-checkbox checkout-agree">
                <label class="chm-checkbox mb-0" style="font-size: 18px;">
                  <input class="checkbox-input" type="radio" name="order_status" value="{{ order_status.order_status_id }}" {% if order_status_id == order_status.order_status_id %}checked="checked" disabled="disabled"{% endif %}>
                  {{ order_status.name }}
                </label>
              </div>
            {% endif %}
          {% endfor %}
        {% else %} #}
          {% for order_status in order_statuses %}
            {% if order_status.maccess == 1 %}
              <div class="group-checkbox checkout-agree">
                <label class="chm-checkbox mb-0" style="font-size: 18px;">
                  <input class="checkbox-input" type="radio" name="order_status" value="{{ order_status.order_status_id }}" data-bg="{{ order_status.jclr_bg }}" data-co="{{ order_status.jclr_text }}" data-orderid="{{ order_id }}" data-sname="{{ order_status.name }}" {% if order_status_id == order_status.order_status_id %}checked="checked"{% endif %}>
                  {{ order_status.name }}
                </label>
              </div>
            {% else %}
              {% if order_status_id == 15 and order_status.order_status_id == 15 %}
                <div class="group-checkbox checkout-agree">
                  <label class="chm-checkbox mb-0" style="font-size: 18px;">
                    <input class="checkbox-input" type="radio" name="order_status" value="{{ order_status.order_status_id }}" {% if order_status_id == order_status.order_status_id %}checked="checked" disabled="disabled"{% endif %}>
                    {{ order_status.name }}
                  </label>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        {# {% endif %} #}
      </div>
  </div>

    <div class="modal-footer d-block px-0">
      <div class="m-0 px-3">
        <div class="row">
          <div class="col-12 col-sm-4 ml-auto mr-auto">
            <button type="button" id="save_order_status" data-loading="{{ text_loading }}" class="btn btn-primary btn-block text-truncate">{{ button_continue }}</button>
          </div>
        </div>
      </div>
    </div>
</div>
