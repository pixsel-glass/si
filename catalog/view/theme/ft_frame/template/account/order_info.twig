{{ header }}
<div id="account-order" class="container">

  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">
    {% if column_left %}
    <div class="col-12 col-sm col-lg-3 order-lg-1 col-aside">
      {{ column_left }}
    </div>
    {% endif %}
    {% if column_right %}
    <div class="col-12 col-sm col-lg-3 order-lg-3 col-aside">
      {{ column_right }}
    </div>
    {% endif %}
    <div id="content" class="col-12 col-lg order-lg-2 mb-3">
      {{ content_top }}
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb p-0 mb-3 bg-transparent" itemscope itemtype="http://schema.org/BreadcrumbList">
          {% for breadcrumb in breadcrumbs %}
          {% if loop.index == 1 %}
          <li class="breadcrumb-item p-0" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
            <a class="text-dark" href="{{ breadcrumb.href }}"  itemprop="item">
              <meta itemprop="name" content="{{ g_text_home }}" />
              <svg class="ft-icon-18 d-block" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
            </a>
            <meta itemprop="position" content="{{ loop.index }}" />
          </li>
          {% elseif breadcrumbs|length != loop.index %}
          <li class="breadcrumb-item p-0" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
            <a class="text-dark" href="{{ breadcrumb.href }}" itemprop="item">
              <span itemprop="name">{{ breadcrumb.text }}</span>
            </a>
            <meta itemprop="position" content="{{ loop.index }}" />
          </li>
          {% else %}
          <li class="breadcrumb-item p-0 active">
            <span>{{ breadcrumb.text }}</span>
          </li>
          {% endif %}
          {% endfor %}
        </ol>
      </nav>
      <h1 class="h2 mb-4">{{ heading_title }}</h1>
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th class="text-left" colspan="2">{{ text_order_detail }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="text-left" style="width: 50%;">{% if invoice_no %} <b>{{ text_invoice_no }}</b> {{ invoice_no }}<br />
              {% endif %} <b>{{ text_order_id }}</b> #{{ order_id }}<br />
              <b>{{ text_date_added }}</b> {{ date_added }}
              {% if shipping_address %}<br />
               <b>{{ text_shipping_address }}</b> {{ shipping_address }}
                {% endif %}
            </td>
            <td class="text-left" style="width: 50%;">{% if payment_method %} <b>{{ text_payment_method }}</b> {{ payment_method }}<br />
              {% endif %}
              {% if shipping_method %} <b>{{ text_shipping_method }}</b> {{ shipping_method }} {% endif %}

              </td>
          </tr>
        </tbody>
      </table>
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <th class="text-left">{{ column_name }}</th>
              <th class="text-left d-none d-md-table-cell">{{ column_model }}</th>
              <th class="text-right">{{ column_quantity }}</th>
              <th class="text-right d-none d-md-table-cell">
                {{ column_price }}
                {% if pixsel_tax_status %}
                  <span class="text-gray-500 font-weight-normal">{{ lang_with }}</span>
                {% endif %}
              </th>
              <th class="text-right d-none d-md-table-cell">
                {{ column_total }}
                {% if pixsel_tax_status %}
                  <span class="text-gray-500 font-weight-normal">{{ lang_with }}</span>
                {% endif %}
              </th>
              <th class="text-left d-md-none"></th>
          </thead>
          <tbody>

          {% for product in products %}
          <tr>
            <td class="text-left">{{ product.name }}
              {% for option in product.option %} <br />
              <small><b>{{ option.pixsel_sku }}</b></small>&nbsp;<small> - {{ option.name }}: {{ option.value }}</small> {% endfor %}</td>
            <td class="text-left d-none d-md-table-cell">{{ product.model }}</td>
            <td class="text-right">{{ product.quantity }}</td>
            <td class="text-right d-none d-md-table-cell">
              {{ product.price }}
              {% if pixsel_tax_status %}</br>
              <span class="text-gray-500 font-weight-normal">{{ product.tax_price }} {{ lang_without }}</span>
              {% endif %}
            </td>
            <td class="text-right d-none d-md-table-cell">{{ product.total }}
              {% if pixsel_tax_status %}</br>
              <span class="text-gray-500 font-weight-normal">{{ product.tax_total }} {{ lang_without }}</span>
              {% endif %}
            </td>

            <td class="text-left d-md-none" style="white-space: nowrap;">
              <div class="order_price mb-2 d-flex justify-content-between"><span>{{ column_price }}:</span> <span class="pl-2">{{ product.price }}</span></div>
              <div class="order_ptotal d-flex justify-content-between"><span>{{ column_total }}:</span> <span class="pl-2">{{ product.total }}</span></div>
            </td>
          </tr>
          {% endfor %}
          {% for voucher in vouchers %}
          <tr>
            <td class="text-left">{{ voucher.description }}</td>
            <td class="text-left"></td>
            <td class="text-right">1</td>
            <td class="text-right">{{ voucher.amount }}</td>
            <td class="text-right">{{ voucher.amount }}</td>
            {% if products %}
            <td></td>
            {% endif %} </tr>
          {% endfor %}
            </tbody>
           </table>

           <div class="table order_info_totals">
            {#{% for total in totals %}
              {% if total.code == 'sub_total' %}
              <div class="d-flex justify-content-end flex-nowrap">
                <div class="text-right pr-4 flex-grow-1"><b>{{ total.title }} {% if total.code == 'sub_total' and pixsel_tax_status %}{{ lang_with }}{% endif %}</b></div>
                <div class="text-right total-text">{{ total.text }}</div>
              </div>

                {% if pixsel_tax_status %}
                  <div class="d-flex justify-content-end flex-nowrap">
                    <div class="text-right pr-4 flex-grow-1 text-gray-500"><b>{{ total.title }} {% if total.code == 'sub_total' and pixsel_tax_status %}{{ lang_without }}{% endif %}</b></div>
                    <div class="text-right total-text text-gray-500">{{ total.tax_text }}</div>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}#}
            {% set shipcost = 0 %}
            {% for total in totals %}
              {% if total.code == 'shipping' %}
                {% set shipcost = total.cleantext %}
              {% endif %}
              <div class="d-flex justify-content-end flex-nowrap" {% if total.code == 'total' and shipcost == 0 or total.code == 'shipping' and shipcost == 0 %}style="display: none !important;"{% endif %}>
                <div class="text-right pr-4 flex-grow-1 font-weight-600"><b>{{ total.title }} {% if total.code == 'sub_total' or total.code == 'total' or total.code == 'shipping' and pixsel_tax_status %}{{ lang_with }}{% endif %}</b></div>
                <div class="text-right total-text font-weight-600">{{ total.text }}</div>
              </div>

                {% if pixsel_tax_status and total.code == 'total' and shipcost > 0 %}
                  <div class="d-flex justify-content-end flex-nowrap">
                    <div class="text-right pr-4 flex-grow-1 text-gray-500"><b>{{ total.title }} {{ lang_without }}</b></div>
                    <div class="text-right total-text text-gray-500">{{ total.tax_text }}</div>
                  </div>
                {% endif %}

                {% if pixsel_tax_status and total.code != 'shipping' and total.code != 'total' %}
                  <div class="d-flex justify-content-end flex-nowrap">
                    <div class="text-right pr-4 flex-grow-1 text-gray-500"><b>{{ total.title }} {% if total.code == 'sub_total' and pixsel_tax_status %}{{ lang_without }}{% endif %}</b></div>
                    <div class="text-right total-text text-gray-500">{{ total.tax_text }}</div>
                  </div>
                {% endif %}
            {% endfor %}
          </div>
      </div>
      {% if comment %}
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th class="text-left">{{ text_comment }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="text-left">{{ comment }}</td>
          </tr>
        </tbody>
      </table>
      {% endif %}
      {% if histories %}
      <h5>{{ text_history }}</h5>
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th class="text-left">{{ column_date_added }}</th>
            <th class="text-left">{{ column_status }}</th>
            <th class="text-left">{{ column_comment }}</th>
          </tr>
        </thead>
        <tbody>

        {% if histories %}
        {% for history in histories %}
        <tr>
          <td class="text-left">{{ history.date_added }}</td>
          <td class="text-left">{{ history.status }}</td>
          <td class="text-left">{{ history.comment }}</td>
        </tr>
        {% endfor %}
        {% else %}
        <tr>
          <td colspan="3" class="text-center">{{ text_no_results }}</td>
        </tr>
        {% endif %}
          </tbody>

      </table>
      {% endif %}
      <div class="">
        {# <div class=""><a href="{{ continue }}" class="btn btn-primary px-4">{{ button_continue }}</a></div>#}
      </div>
      </div>
    </div>
  {{ content_bottom }}
</div>
{{ footer }}
