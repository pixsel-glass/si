            console.log(jqXhr);
            console.log(textStatus);
            console.log(errorThrown);
          },
        });
      }
    });
  } else {
    $.ajax({
      type: "POST",
      url: "index.php?route=account/manager_list/orderAf",
      data: {order_id: order_id},
      dataType: "json",
      beforeSend: function() {
        $('body').append('<div class="loading_mask"></div>');
        $('.loading_mask').html('<div class="center-body"><div class="opc-loader-circle"></div></div>');
        $('.loading_mask').show();
      },
      complete: function() {
      },
      success: function(json) {
        if (json['autofolie']) {
          $('td.sendorder-'+json['pixsel']).find('span').text('#'+json['autofolie']).addClass('d-block').removeClass('d-none');

          $('td.sendorder-'+json['pixsel']).find('#button-af-remove').attr('data-autofolie', json['autofolie']).removeClass('d-none');
        }

        $('.loading_mask').html('');
        $('.loading_mask').hide();
      },
      error: function (jqXhr, textStatus, errorThrown) {
        console.log(jqXhr);
        console.log(textStatus);
        console.log(errorThrown);
      },
    });
  }
});

$(document).on('click', '#button-af-remove', function(e) {
  e.preventDefault();
  
  var order_id = $(this).data('orderid');
  var autofolie = $(this).data('autofolie');

  customConfirm('{{ text_remove_af }}', function (confirmed) {
    if (confirmed) {
      $.ajax({
        type: "POST",
        url: "index.php?route=account/manager_list/orderAfRemove",
        data: {order_id: order_id, autofolie: autofolie},
        dataType: "json",
        beforeSend: function() {
          $('body').append('<div class="loading_mask"></div>');
          $('.loading_mask').html('<div class="center-body"><div class="opc-loader-circle"></div></div>');
          $('.loading_mask').show();
        },
        complete: function() {
        },
        success: function(json) {

          // $('#button-af-remove[data-orderid="'+order_id+'"]').closest('td').html('');
          $('#button-af-remove[data-orderid="'+order_id+'"]').closest('td').find('span').text('').addClass('d-none').removeClass('d-block');
          $('#button-af-remove[data-orderid="'+order_id+'"]').attr('data-autofolie', '0').addClass('d-none');

          $('.loading_mask').html('');
          $('.loading_mask').hide();
        },
        error: function (jqXhr, textStatus, errorThrown) {
          console.log(jqXhr);
          console.log(textStatus);
          console.log(errorThrown);
        },
      });
    }
  });
});

function customConfirm(message, callback) {
  Swal.fire({
    title: message,
    icon: 'question',
    showCancelButton: true,
    confirmButtonText: '{{ text_yes }}',
    cancelButtonText: '{{ text_no }}',
    customClass: {
      popup: 'custom-popup',
      confirmButton: 'custom-confirm',
      cancelButton: 'custom-cancel'
    }
  }).then((result) => {
    if (result.isConfirmed) {
      callback(true);
    } else {
      callback(false);
    }
  });
}

