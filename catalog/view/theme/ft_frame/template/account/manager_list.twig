$(document).on('click', '#button-af', function(e) {
  e.preventDefault();

  var order_id = $(this).data('orderid');
  var autofoliestatus = $(this).data('autofoliestatus');
  
  if (autofoliestatus != 31) {
    customConfirm('{{ text_update_af }}', function (confirmed) {
