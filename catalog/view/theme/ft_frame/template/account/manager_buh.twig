{{ header }}
<div id="account-order" class="container">
  <div class="row">
		{% if column_left %}
		<div class="col-12 col-sm col-lg-3 order-lg-1 col-aside">
			{{ column_left }}
		</div>
		{% endif %}
		{% if column_right %}
		<div class="col-12 col-sm col-lg-3 order-lg-3 col-aside">
			{{ column_right }}
		</div>
		{% endif %}
    <div id="content" class="col-12 col-lg order-lg-2 mb-3">
			{{ content_top }}
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb p-0 mb-3 bg-transparent" itemscope itemtype="http://schema.org/BreadcrumbList">
          {% for breadcrumb in breadcrumbs %}
          {% if loop.index == 1 %}
          <li class="breadcrumb-item p-0" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
            <a class="text-dark" href="{{ breadcrumb.href }}"  itemprop="item">
              <meta itemprop="name" content="{{ g_text_home }}" />
            	<svg class="ft-icon-18 d-block" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            		<path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
            	</svg>
            </a>
            <meta itemprop="position" content="{{ loop.index }}" />
          </li>
          {% elseif breadcrumbs|length != loop.index %}
          <li class="breadcrumb-item p-0" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
            <a class="text-dark" href="{{ breadcrumb.href }}" itemprop="item">
              <span itemprop="name">{{ breadcrumb.text }}</span>
            </a>
            <meta itemprop="position" content="{{ loop.index }}" />
          </li>
          {% else %}
          <li class="breadcrumb-item p-0 active">
            <span>{{ breadcrumb.text }}</span>
          </li>
          {% endif %}
          {% endfor %}
        </ol>
      </nav>

    <div class="card filter-card mt-2 mb-3" id="pixsel-order-listing">
      <div class="card-header filter-listing border-0 px-4">
        <div class="row no-gutters align-items-center justify-content-md-between orderlistingpixsel">

          <div class="select_buh">
            <div class="form-group">
              {#<div class="input-group">
                <label for="input-select-sebes"><span>{{ text_sebes }}</span>
                  <input autocomplete="off" type="text" name="sebes" value="" placeholder="0.000" id="input-select-sebes" class="form-control" />
                </label>
              </div><div class="input-group">
                <label for="input-select-rshpr"><span>{{ text_rshpr }}</span>
                  <input autocomplete="off" type="text" name="rshpr" value="" placeholder="0.000" id="input-select-rshpr" class="form-control" />
                </label>
              </div>#}
              <div class="input-group">
                <label for="input-select-datefrom" class="date">{{ text_from }}
                  <input autocomplete="off" type="text" name="date_from" data-date-format="DD-MM-YYYY" value="" placeholder="" id="input-select-datefrom" class="form-control" />
                  <span class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></span>
                </label>
              </div><div class="input-group">
                <label for="input-select-dateto" class="date">{{ text_to }}
                  <input autocomplete="off" type="text" name="date_to" data-date-format="DD-MM-YYYY" value="" placeholder="" id="input-select-dateto" class="form-control" />
                  <span class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></span>
                </label>
              </div><div class="input-group" style="justify-content: space-evenly; font-size: 16px; font-weight: 600;">
                <span class="month-left"><</span>
                <span class="month-current" data-datestart="" data-dateend=""></span>
                <span class="month-right">></span>
              </div>
              <span class="input-group-btn">
                <input type="submit" value="{{ text_create_report }}" id="button-create-report" class="btn btn-primary" />
              </span>
              <button class="btn btn-default pl-0 pr-0 mr-2 box-shadow-off order-0 edit-buh"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="butt" stroke-linejoin="bevel"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></button>
            </div>
          </div>

        </div>
      </div>
    </div>

      <h1 class="h2 mb-4">{{ text_report }}</h1>

      <div class="row col-12 col-lg order-lg-2 mb-3">
        <div class="export-info"></div>
      </div>


      </div>
    </div>
	{{ content_bottom }}
</div>

<script src="catalog/view/theme/ft_frame/javascript/common.js"></script>
<script src="catalog/view/javascript/opc/select2.min.js"></script>

<link rel="stylesheet" type="text/css" href="/catalog/view/javascript/font-awesome/css/font-awesome.min.css">

<script src="catalog/view/javascript/jquery/datetimepicker/moment/moment.min.js" type="text/javascript"></script>
<script src="catalog/view/javascript/jquery/datetimepicker/moment/moment-with-locales.min.js" type="text/javascript"></script>
<script src="catalog/view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.js" type="text/javascript"></script>
<link href="catalog/view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.css" type="text/css" rel="stylesheet" media="screen" />
<script type="text/javascript">
  $('.date').datetimepicker({
    language: '{{ current_language }}',
    pickTime: false
  });

  let curmonth, current_month, current_year, current_date;

  moment.locale('{{ current_language }}');
  curmonth = moment.months()[moment().month()];
  current_month = moment().month();
  current_year = moment().year();

  current_datestart = moment([current_year,current_month]).startOf('month').format("DD-MM-YYYY"); 
  current_dateend = moment([current_year,current_month]).endOf('month').format("DD-MM-YYYY"); 

  $('.month-current').text(curmonth);
  $('.month-current').attr('data-datestart', current_datestart);
  $('.month-current').attr('data-dateend', current_dateend);

  $('.month-left').on('click', function() {
    if (current_month == 0) {
      current_month = 12;
    }

    curmonth = moment.months()[current_month-1];
    current_month = current_month-1;
    $('.month-current').text(curmonth);

    current_datestart = moment([current_year,current_month]).startOf('month').format("DD-MM-YYYY"); 
    current_dateend = moment([current_year,current_month]).endOf('month').format("DD-MM-YYYY"); 
    $('.month-current').attr('data-datestart', current_datestart);
    $('.month-current').attr('data-dateend', current_dateend);
  });
  
  $('.month-right').on('click', function() {
    if (current_month == 11) {
      current_month = -1;
    }
    curmonth = moment.months()[current_month+1];
    current_month = current_month+1;
    $('.month-current').text(curmonth);

    current_datestart = moment([current_year,current_month]).startOf('month').format("DD-MM-YYYY"); 
    current_dateend = moment([current_year,current_month]).endOf('month').format("DD-MM-YYYY"); 
    $('.month-current').attr('data-datestart', current_datestart);
    $('.month-current').attr('data-dateend', current_dateend);
  });

  $(document).delegate('#button-create-report', 'click', function(e) {
    e.preventDefault();

    //if ($('#input-select-sebes').val() == '' || $('#input-select-sebes').val() == 0 || $('#input-select-sebes').val() == null || $('#input-select-sebes').val() == undefined) {
    //  $('#input-select-sebes').css('border', '1px solid red');
    //  return;
    //} else {
    //  $('#input-select-sebes').css('border', '1px solid #EAEDF7');
    //}

    // if ($('#input-select-rshpr').val() == '' || $('#input-select-rshpr').val() == 0 || $('#input-select-rshpr').val() == null || $('#input-select-rshpr').val() == undefined) {
    //  $('#input-select-rshpr').css('border', '1px solid red');

    //  return;
    // } else {
    //  $('#input-select-rshpr').css('border', '1px solid #EAEDF7');
    // }

    if ($('#input-select-datefrom').val() && $('#input-select-dateto').val()) {
      var date_start = $('#input-select-datefrom').val();
      var date_end = $('#input-select-dateto').val();
    } else {
      var date_start = $('.month-current').attr('data-datestart');
      var date_end = $('.month-current').attr('data-dateend');
    }

    var sebes = $('#input-select-sebes').val();
    if ($('#input-select-rshpr').val() == '' || $('#input-select-rshpr').val() == 0 || $('#input-select-rshpr').val() == null || $('#input-select-rshpr').val() == undefined) {
      var rshpr = 0;
    } else {
      var rshpr = $('#input-select-rshpr').val();
    }

    $('.export-info').html('');

    $.ajax({
      type: "POST",
      url: "index.php?route=account/manager_buh/export_info",
      data: {date_start: date_start, date_end: date_end},
      dataType: "json",
      beforeSend: function() {
				if(!$('.loading_mask').length){
					$('body').append('<div class="loading_mask"></div>');
				}
				$('.loading_mask').html('<div class="center-body"><div class="opc-loader-circle"></div></div>');
				$('.loading_mask').show();
      },
      success: function (json) {

        setTimeout(function(){
          $('.loading_mask').html('');
          $('.loading_mask').hide();

          var file = "{{ text_file }}";
          var rashod = "{{ text_rashod }}";
          var matp = "{{ text_polysk }}";
          var matm = "{{ text_mat }}";

          if (parseFloat(json[0]) > 0 || parseFloat(json[1]) > 0 || parseFloat(json[2]) > 0 || parseFloat(json[3]) > 0) {
            if (rshpr > 0) {
              json[0] = parseFloat(json[0])+(parseFloat(json[0])/100*rshpr);
              json[1] = parseFloat(json[1])+(parseFloat(json[1])/100*rshpr);
              json[2] = parseFloat(json[2])+(parseFloat(json[2])/100*rshpr);
              json[3] = parseFloat(json[3])+(parseFloat(json[3])/100*rshpr);
            }

            // console.log(json[4]);

            // $('.export-info').html('<table class="table table-bordered"><tbody><tr><td rowspan="2" class="text-center" style="vertical-align: middle;">' + file + '</td><td colspan="2" class="text-center">' + rashod + '</td></tr><tr><td class="text-center">' + matp + ', m2</td><td class="text-center">' + matm + ', m2</td></tr><tr><td><a href="index.php?route=account/manager_buh/export&date_start=' + date_start + '&date_end=' + date_end + '&sebes=' + sebes + '&rshpr=' + rshpr + '" target="_blank">{{ text_downloads }} ' + date_start + '-' + date_end + '.xls</a></td><td class="text-center">' + json[0] + '</td><td class="text-center">' + json[1] + '</td></tr><tr><td><a href="index.php?route=account/manager_buh/export_brak&date_start=' + date_start + '&date_end=' + date_end + '&sebes=' + sebes + '&rshpr=' + rshpr + '" target="_blank">{{ text_downloads }} ' + date_start + '-' + date_end + '-BRAK.xls</a></td><td class="text-center">' + json[2] + '</td><td class="text-center">' + json[3] + '</td></tr></tbody></table>');
            $('.export-info').html('<table class="table table-bordered"><tbody><tr><td rowspan="2" class="text-center" style="vertical-align: middle;">' + file + '</td><td colspan="2" class="text-center">' + rashod + '</td></tr><tr><td class="text-center">' + matp + ', m2</td><td class="text-center">' + matm + ', m2</td></tr><tr><td><a href="index.php?route=account/manager_buh/export&date_start=' + date_start + '&date_end=' + date_end + '" target="_blank">{{ text_downloads }} ' + date_start + '-' + date_end + '.xls</a></td><td class="text-center">' + json[0] + '</td><td class="text-center">' + json[1] + '</td><td><a href="/index.php?route=account/manager_buh/infaktAllPdf&token=' + json[4] + '" target="_blank"><svg style="width: 24px;" width="24px" height="24px" viewBox="0 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M10.5 4.5V8.5H6.5M10.5 4.5H18.5V20.5H6.5V8.5L10.5 4.5Z" stroke="#121923" stroke-width="1.2"></path> <path d="M12.7414 13.14L12.749 13.1046C12.896 12.4991 13.0809 11.7442 12.9365 11.0602C12.8402 10.5206 12.4425 10.3104 12.1031 10.2952C11.7028 10.2775 11.3456 10.5054 11.2569 10.8373C11.0897 11.4453 11.2392 12.2762 11.5128 13.3351C11.1683 14.1559 10.6186 15.3491 10.2158 16.0584C9.46592 16.446 8.46022 17.0438 8.31075 17.7987C8.28036 17.9381 8.31582 18.1154 8.39942 18.275C8.49315 18.4523 8.64261 18.5891 8.81741 18.655C8.89341 18.6828 8.9846 18.7056 9.091 18.7056C9.53686 18.7056 10.2588 18.3459 11.2215 16.6942C11.3684 16.6461 11.5204 16.5954 11.6673 16.5448C12.3564 16.3117 13.0708 16.0685 13.7167 15.9596C14.4311 16.3421 15.2443 16.5878 15.7966 16.5878C16.3437 16.5878 16.5591 16.2636 16.6401 16.0685C16.782 15.7265 16.7136 15.2959 16.4831 15.0653C16.1487 14.736 15.3355 14.6499 14.0689 14.8069C13.4457 14.4269 13.0378 13.9102 12.7414 13.14ZM9.96245 16.9881C9.61032 17.4998 9.34433 17.7557 9.19993 17.8671C9.36966 17.5555 9.70152 17.2262 9.96245 16.9881ZM12.1816 11.0222C12.3133 11.2477 12.2956 11.9291 12.1943 12.2737C12.0701 11.7695 12.0524 11.0552 12.1259 10.9716L12.1816 11.0222ZM12.1411 14.0748C12.4121 14.5435 12.7541 14.9463 13.1316 15.2452C12.5844 15.3693 12.0853 15.5745 11.6395 15.7569C11.5331 15.8 11.4292 15.843 11.3279 15.8836C11.6648 15.2731 11.946 14.5815 12.1411 14.0748ZM16.0828 15.7341L16.0676 15.7569C16.0676 15.7569 15.8346 15.8988 14.9403 15.5466C15.9688 15.4985 16.0828 15.7341 16.0828 15.7341Z" fill="#121923"></path> </g></svg></a></td></tr><tr><td><a href="index.php?route=account/manager_buh/export_brak&date_start=' + date_start + '&date_end=' + date_end + '" target="_blank">{{ text_downloads }} ' + date_start + '-' + date_end + '-BRAK.xls</a></td><td class="text-center">' + json[2] + '</td><td class="text-center">' + json[3] + '</td></tr></tbody></table>');
          }
        }, 40000);
      }
    });
  });

  $('#input-select-sebes, #input-select-rshpr').keyup(function(){
    var val = $(this).val();
    if(isNaN(val)){
         val = val.replace(/[^0-9\.]/g,'');
         if(val.split('.').length>2) 
             val =val.replace(/\.+$/,"");
    }
    $(this).val(val); 
  });

  $('.edit-buh').on('click', function() {
    $.ajax({
      url: 'index.php?route=account/manager_buh/editBuh',
      type: 'GET',
      dataType: 'html',
      success: function(data) {
        var html = '<div id="ft-edit-buh-modal" class="modal fade" role="dialog">' + data + '</div>'

        $('body').append(html);

        $('#ft-edit-buh-modal').modal('show');
      },
      error: function(xhr, ajaxOptions, thrownError) {
        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
      }
    });

    $(document).on('hide.bs.modal', '#ft-edit-buh-modal.modal.fade', function () {
      $('#ft-edit-buh-modal').remove();
    });
  });

  $(document).on('hide.bs.modal', '#ft-edit-buh-modal.modal.fade', function () {
    $('#ft-edit-buh-modal').remove();
  });

  $(document).on('click', '#ft-edit-buh-modal #save_buh_fileds', function(e) {
      if ($('.select_buh_modal input[name="manager_buh_sebes"]').val() == '' || $('.select_buh_modal input[name="manager_buh_sebes"]').val() == 0 || $('.select_buh_modal input[name="manager_buh_sebes"]').val() == null || $('.select_buh_modal input[name="manager_buh_sebes"]').val() == undefined) {
        $('.select_buh_modal input[name="manager_buh_sebes"]').css('border', '1px solid red');
        return;
      } else {
        $('.select_buh_modal input[name="manager_buh_sebes"]').css('border', '1px solid #EAEDF7');
      }
      if ($('.select_buh_modal input[name="manager_buh_rshpr"]').val() == '' || $('.select_buh_modal input[name="manager_buh_rshpr"]').val() == 0 || $('.select_buh_modal input[name="manager_buh_rshpr"]').val() == null || $('.select_buh_modal input[name="manager_buh_rshpr"]').val() == undefined) {
        var rshpr = 0;
      } else {
        var rshpr = $('.select_buh_modal input[name="manager_buh_rshpr"]').val();
      }

      var sebes = $('.select_buh_modal input[name="manager_buh_sebes"]').val();
      // var rshpr = $('.select_buh_modal input[name="rshpr"]').val();

      $.ajax({
        url: 'index.php?route=account/manager_buh/saveBuh',
        type: 'post',
        // data: {sebes: sebes, rshpr: rshpr},
        data: $('#ft-edit-buh-modal #editBuhModalForm').serialize(),
        dataType: 'json',
        beforeSend: function() {
        },
        complete: function() {
        },
        success: function(json) {

          if (json['error']) {
            $('#ft-edit-buh-modal .modal-body').prepend('<div class="alert alert-danger alert-dismissible mt-4 mb-4">' + json['error'] + ' <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button></div>');
          }

          setTimeout(function () {
            $('#ft-edit-buh-modal .alert').remove();
          }, 3000);

          if(json['success']){
            $('#ft-edit-buh-modal .modal-body').prepend('<div class="alert alert-success alert-dismissible mt-4 mb-4">' + json['success'] + ' <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button></div>');
            setTimeout(function () {
              $('#ft-edit-buh-modal').modal('hide');
              $('#ft-edit-buh-modal').remove();
              $('.modal-backdrop').hide();
              $("body").removeClass("modal-open");
              $("body").css("padding-right", "0");
            }, 500);
          }

        },
        error: function(xhr, ajaxOptions, thrownError) {
          alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
      });
  });

</script>
{{ footer }}
