<div class="modal-dialog modal-dialog-center modal-lg">
  <div class="modal-content border-0 rounded-lg mh-100 h-100">
    <div class="modal-header no-gutters">
      <div class="col">
        <div class="h5 modal-title">{{ text_edit }} №{{ order_id }}</div>
      </div>
      <div class="col-auto">
            <a href="#" class="d-block ml-2" data-dismiss="modal">
              <svg class="d-block ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
              </svg>
            </a>
      </div>
    </div>
    <div class="modal-body dscmodal p-4">
                <form id="quickOrderForm" method="post">
                  <!-- Поле для вибору покупця -->
                  <div class="form-group">
                    <label>{{ text_customer }}</label>
                    <input type="text" name="customer" id="input-customer" class="form-control" value="{{ customer_name_wbr }}" />
                    <input type="hidden" name="customer_id" id="input-customer-id" value="0" />
                    <input type="hidden" name="customer_new_name" id="input-customer-new-name" value="" />
                  </div>

                  <div class="form-group">
                    <label for="input-order-nip" class="control-label">{{ entry_vat }}</label>
                    <input autocomplete="off" id="input-order-nip" type="text" name="order_nip" value="{{ order_nip }}" placeholder="{{ entry_nip }}" class="form-control">
                  </div>

                  <div class="form-group">
                    <label class="control-label" for="input-country{{ address_row }}">{{ entry_country }}</label>
                    <div class="">
                      <select name="country_id" id="input-country" class="form-control">
                      <option value="">{{ text_select }}</option>
                      {% for country in countries %}
                         {% if country.country_delivery_id == country_id %}
                         <option value="{{ country.country_delivery_id }}" selected="selected">{{ country.name }}</option>
                         {% else %}
                         <option value="{{ country.country_delivery_id }}">{{ country.name }}</option>
                         {% endif %}
                      {% endfor %}
                      </select>
                  </div>

                  <div id="paymentinfo" class="row mt-2">
                    <div class="form-group col-xs-12 col-sm-6">
                      <label>{{ text_payment_method }}</label>
                      <select name="payment_method" id="input-payment-method" class="form-control">
                        <option value="">{{ text_select }}</option>
                        {% for method in payment_methods %}
                          <option value="{{ method.code }}" {% if method.code == order_payment_method %}selected{% endif %}>{{ method.title }}</option>
                        {% endfor %}
                      </select>
                    </div>
                    <div class="form-group col-xs-12 col-sm-6">
                      <label class="control-label" for="input-payed">{{ entry_payed }}</label>
                      <select name="payed" id="input-payed" class="form-control">
                        <option value="">{{ text_select }}</option>
                        <option value="0" {% if payed == 0 %}selected="selected"{% endif %}>{{ text_no }}</option>
                        <option value="1" {% if payed == 1 %}selected="selected"{% endif %}>{{ text_yes }}</option>
                      </select>
                      {% if payed_with is not empty %}<span class="text-muted font-size-12">{{ entry_spayed }} {{ payed_with }}</span>{% endif %}
                    </div>
                  </div>


                  <div class="form-group">
                    <label>{{ text_shipping_method }}</label>
                    <select name="shipping_method" id="input-shipping-method" class="form-control">
                      <option value="">{{ text_select }}</option>
                      {% for method in shipping_methods %}
                        {#{% if order_shipping_method == 'gls.gls' %}
                          {% set order_shipping_method = 'gls' %}
                        {% elseif order_shipping_method == 'dhl.dhl' %}
                          {% set order_shipping_method = 'dhl' %}
                        {% elseif order_shipping_method == 'hrx.hrx' %}
                          {% set order_shipping_method = 'hrx' %}
                        {% endif %}#}
                        <option value="{{ method.code }}" {% if method.code == order_shipping_method %}selected{% endif %}>{{ method.title }}</option>
                      {% endfor %}
                    </select>

                    <div id="opc-shipping-address" class="row mt-2 d-none">
                        <div class="form-group col-xs-12 col-sm-6">
                            <label for="input-payment-city" class="control-label opc-label">{{ entry_city }}</label>
                            <input autocomplete="off" id="input-payment-city" type="text" name="city" value="{{ shipping_city }}" placeholder="{{ entry_city }}" class="form-control">
                        </div>
                        <div class="form-group col-xs-12 col-sm-6">
                            <label for="input-payment-address-1" class="control-label opc-label">{{ entry_address_1 }}</label>
                            <input autocomplete="off" id="input-payment-address-1" type="text" name="address_1" value="{{ shipping_address_1 }}" placeholder="{{ entry_address_1 }}" class="form-control">
                        </div>
                        <div class="form-group col-xs-12 col-sm-6">
                            <label for="input-payment-postcode" class="control-label opc-label">{{ entry_postcode }}</label>
                            <input autocomplete="off" id="input-payment-postcode" type="text" name="postcode" value="{{ shipping_postcode }}" placeholder="{{ entry_postcode }}" class="form-control">
                        </div>
                    </div>
                    <input type="hidden" name="parcelLocker" class="parcel-locker-value" value="{{ inpostParcelLocker }}">
                    <div class="inpost_address">{{ parcelAddressLocker }}{% if parcelAddressLocker is empty %}{% else %}<svg fill="#000000" style="margin-left: 5px; width: 28px;" width="24px" height="24px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M11.707,5.293A1,1,0,0,1,11,7H4V17H9a1,1,0,0,1,0,2H3a1,1,0,0,1-1-1V6A1,1,0,0,1,3,5H8.586L7.293,3.707A1,1,0,1,1,8.707,2.293ZM21,5H15a1,1,0,0,0,0,2h5V17H13a1,1,0,0,0-.707,1.707l3,3a1,1,0,0,0,1.414-1.414L15.414,19H21a1,1,0,0,0,1-1V6A1,1,0,0,0,21,5Z"></path></g></svg>{% endif %}</div>
                  </div>
                </form>

        <table class="table table-bordered">
          <thead>
            <tr>
              <td class="text-left" style="width: 40%;">{{ column_product }}</td>
              <td class="text-center">{{ column_model }}</td>
              <td class="text-center" style="width: 10%;">{{ column_quantity }}</td>
              <td class="text-right">{{ column_price }}{% if pixsel_tax_status %}</br>{{ lang_with }}{% endif %}</td>
              <td class="text-right">{{ column_total }}{% if pixsel_tax_status %}</br>{{ lang_with }}{% endif %}</td>
              <!-- pixsel start -->
              <td class="text-right"></td>
              <!-- pixsel end -->
            </tr>
          </thead>
          <tbody>
            {% for product in products %}
              <tr>
                <td class="text-left"><a href="{{ product.href }}">{{ product.name }}</a> {% for option in product.option %}
                    <br/>
                    {% if option.type != 'file' %}
                      &nbsp;
                      <small> - {{ option.name }}: <a href="#" id="editOption" onclick="editProductOpen({{ product.product_id }}, {{ option.product_option_value_id }}); return false" data-pid="{{ product.product_id }}" data-oid="{{ option.product_option_value_id }}">{{ option.value }}</a></small> {% else %}
                      &nbsp;
                      <small> - {{ option.name }}: <a href="{{ option.href }}">{{ option.value }}</a></small> {% endif %}
                  {% endfor %}</td>
                <td class="text-center" style="vertical-align: middle;">{{ product.model }}</td>
                
                <!-- pixsel start -->
                <td class="text-right" style="vertical-align: middle;">
                  <div class="product-qty" style="display: flex;">
                    <input type="number" value="{{ product.quantity }}" class="form-control" min="1" id="product-qty-{{product.order_product_id}}">
                    <button type="button" class="btn btn-primary btn-xs btn-update" data-id="{{product.order_product_id}}"><i class="fa fa-refresh"></i></button>
                  </div>
                </td>
                <!-- pixsel end -->
        
                <td class="text-right" style="vertical-align: middle;">
                {% if customer_group_id != 1 %}
                <s>{{ product.rprice }}</s><br>
                {% endif %}
                <strong>{{ product.price }}</strong>
                {% if pixsel_tax_status %}
                </br><span class="text-gray-500">{{ product.tax_price }} {{ lang_without }}</span>
                {% endif %}
                </td>
                <td class="text-right" style="vertical-align: middle;">
                {% if customer_group_id != 1 %}
                <s>{{ product.rtotal }}</s><br>
                {% endif %}
                <strong>{{ product.total }}</strong>
                {% if pixsel_tax_status %}</br><span class="text-gray-500">{{ product.tax_total }} {{ lang_without }}</span>
                {% endif %}
                </td>

                <!-- pixsel start -->
                <td class="text-right" style="vertical-align: middle;">
                  <button type="button" onclick="pixselDeleteProduct('{{ order_id }}', '{{ product.order_product_id }}', '{{product.product_id}}');" class="btn btn-danger"><i class="fa fa-trash-o"></i></button>
                </td>
                <!-- pixsel end -->
        
              </tr>
            {% endfor %}
            <!-- pixsel start -->
            <tr>
              <td class="text-right" colspan="7">
                <button type="button" data-toggle="modal" data-target="#addProductModal" class="btn btn-primary"><i class="fa fa-plus"></i> {{ text_add_product }}</button>
              </td>
            </tr>
            <!-- pixsel end -->
            {% for voucher in vouchers %}
              <tr>
                <td class="text-left"><a href="{{ voucher.href }}">{{ voucher.description }}</a></td>
                <td class="text-left"></td>
                <td class="text-right">1</td>
                <td class="text-right">{{ voucher.amount }}</td>
                <td class="text-right">{{ voucher.amount }}</td>
              </tr>
            {% endfor %}
            {% set shipcost = 0 %}
            {% for total in totals %}
              {% if total.code == 'shipping' %}
                {% set shipcost = total.cleantext %}
              {% endif %}
              <tr class="font-size-12 {% if total.code == 'total' and shipcost == 0 or total.code == 'shipping' and shipcost == 0 %}d-none{% endif %}">
                <td colspan="5" class="valign-middle text-right font-size-12 p-1 font-weight-600 {% if total.code != 'shipping' %}brutto-total{% endif %}">{{ total.title }} {% if total.code == 'sub_total' or total.code == 'total' or total.code == 'shipping' and pixsel_tax_status %} {{ lang_with }}{% endif %}{% if total.code == 'total' %}Brutto{% endif %}</td>
                <td class="text-right font-size-12 p-1 {% if total.code != 'shipping' %}brutto-total{% endif %}">{{ total.text }}</td>
              </tr>
              {% if pixsel_tax_status and total.code == 'total' and shipcost > 0 %}
                <tr>
                  <td colspan="5" class="text-right font-size-12 text-muted p-1 netto-total">{{ lang_without }}</td>
                  <td class="text-right text-muted p-1 netto-total">{{ total.tax_text }}</td>
                </tr>
              {% endif %}
              {% if pixsel_tax_status and total.code != 'shipping' and total.code != 'total' %}
                <tr>
                  <td colspan="5" class="text-right font-size-12 text-muted p-1 netto-total">{{ total.title }}{% if total.code == 'sub_total' and pixsel_tax_status %} {{ lang_without }}{% endif %}</td>
                  <td class="text-right font-size-12 text-muted p-1 netto-total">{{ total.tax_text }}</td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>

        </table>

    </div>
    <div class="modal-footer d-block px-0">
      <div class="m-0 px-3">
        <div class="row">
          <div class="col-12 col-sm-4 ml-auto mr-auto">
            <button type="button" id="save_edit_fileds" data-orderid="{{ order_id }}" data-loading="{{ text_loading }}" class="btn btn-primary btn-block text-truncate">{{ button_continue }}</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

            {% if inpostSandbox or geoWidgetToken %}
            {% set geoWidgetToken = inpostSandbox ? inpostSandbox : geoWidgetToken %}
            <div class="modal fade" id="inpostGeoWidgetModal" tabindex="-1" role="dialog">
                <div class="modal-dialog modal-lg" role="document" style="height: 90%">
                    <div class="modal-content" style="height: 100%">
                        <div class="modal-body" style="height: 100%">
                            <inpost-geowidget id="geoWidget" onpoint="afterPointSelected" token="{{ geoWidgetToken }}" language="en" config="parcelCollect"></inpost-geowidget>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}


