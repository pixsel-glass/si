            $('#ft-order-edit-modal').css('z-index', '1041');
            $('.modal-backdrop:eq(1)').css('z-index', '1042');

            // var product_id = $(this).data('pid');
            // var product_option_value_id = $(this).data('oid');
            var product_id = pid;
            var product_option_value_id = oid;

                setTimeout(function() {
                  $.ajax({
                    url: 'index.php?route=product/product/editAutocomplete&productid=' + product_id,
                    dataType: 'json',
                    success: function(json) {
                      // var json = $.parseJSON(json);
                      // console.log(json);

                      $('#editProductModal input[name=\'product\']').val(json[0]['name']);
                      $('#editProductModal input[name=\'product_id\']').val(json[0]['product_id']);

