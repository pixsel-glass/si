                        optionsHtml += '<label for="option-' + json[0]['option'][i]['product_option_id'] + '">' + json[0]['option'][i]['name'] + '</label>';
                        optionsHtml += '<select id="option-' + json[0]['option'][i]['product_option_id'] + '" name="option[' + json[0]['option'][i]['product_option_id'] + ']" class="form-control">';

                        for (var y = 0; y < json[0]['option'][i]['product_option_value'].length; y++) {
