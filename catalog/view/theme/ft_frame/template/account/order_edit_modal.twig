        <script type="text/javascript">

          $('input[name=\'customer\']').on('input', function(e){
            $('input[name=\'customer_id\']').val(0);
            $('input[name=\'customer_new_name\']').val(e.target.value);
          });
          $('input[name=\'customer\']').autocomplete({
            'source': function(request, response) {
              $.ajax({
                url: 'index.php?route=account/manager_list/autocomplete&filter_name=' + encodeURIComponent(request),
                dataType: 'json',
                success: function(json) {
                  response($.map(json, function(item) {
                    return {
                      label: item['name'],
                      value: item['customer_id']
                    };
                  }));
                }
              });
            },
            'select': function(item) {
              $('input[name=\'customer\']').val(item['label']);
              $('input[name=\'customer_id\']').val(item['value']);
              $('input[name=\'customer_new_name\']').val('');

              // save change and update modal
              var order_id = $('#save_edit_fileds').data('orderid');
              var formData = $("#quickOrderForm").serialize();

              $.ajax({
                url: 'index.php?route=account/manager_list/editOrder&order_id=' + order_id,
                type: 'post',
                data: formData,
                dataType: 'json',
                success: function(json) {
                  if (json['error']) {
                    $('#ft-order-edit-modal .modal-body').prepend('<div class="alert alert-danger alert-dismissible mt-4 mb-4">' + json['error'] + ' <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button></div>');
                  }

                  if(json['success']){
                    $('#ft-order-edit-modal .modal-body').prepend('<div class="alert alert-success alert-dismissible mt-4 mb-4">' + json['success'] + ' <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button></div>');
                    setTimeout(function () {
                      $.ajax({
                        url: 'index.php?route=account/manager_list/edit&order_id=' + order_id,
                        type: 'GET',
                        dataType: 'html',
                        success: function(data) {
                          $('#ft-order-edit-modal').html('');
                          $('#ft-order-edit-modal').html(data);
                        },
                        error: function(xhr, ajaxOptions, thrownError) {
                          console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                        }
                      });
                    }, 300);
                  }
                },
                error: function(xhr, ajaxOptions, thrownError) {
                  console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
              });
            }
          });


