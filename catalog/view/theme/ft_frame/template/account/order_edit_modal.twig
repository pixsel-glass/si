          }
          //});

          $('#editProductModal').on('hidden.bs.modal', function () {
            setTimeout(function () {
              $('.modal-backdrop:eq(1)').hide();
              $('.modal-backdrop:eq(1)').remove();
              // $("body").removeClass("modal-open");
              $("body").css("padding-right", "0");
              $('#ft-order-edit-modal').css('z-index', '1050').css('height', '100%').css('position', 'fixed').css('overflow', 'auto');
              $('.modal-backdrop').css('z-index', '1042');
            }, 200);
          });
          // edit option

          // add product
          $('input[name=\'product\']').autocomplete({
            'source': function(request, response) {
              $.ajax({
                url: 'index.php?route=product/product/autocomplete&filter_name=' + encodeURIComponent(request),
                dataType: 'json',
                success: function(json) {
                  response($.map(json, function(item) {
                    return {
                      label: item['name'],
                      value: item['product_id'],
                      option: item['option'],
                    }
                  }));
                }
              });
            },
            'select': function(item) {
              $('input[name=\'product\']').val(item['label']);
              $('input[name=\'product_id\']').val(item['value']);
              loadProductOptions(item['option']);
            }
          });

          function loadProductOptions(options) {
            var optionsHtml = '';
            for (var i = 0; i < options.length; i++) {
              optionsHtml += '<div class="form-group">';
              optionsHtml += '<label for="option-' + options[i]['product_option_id'] + '">' + options[i]['name'] + '</label>';
              optionsHtml += '<select id="option-' + options[i]['product_option_id'] + '" name="option[' + options[i]['product_option_id'] + ']" class="form-control">';

              for (var y = 0; y < options[i]['product_option_value'].length; y++) {
                var optionValue = options[i]['product_option_value'][y];
                optionsHtml += '<option value="' + optionValue['product_option_value_id'] + '">' + optionValue['name'] + '</option>';
              }

              optionsHtml += '</select>';
              optionsHtml += '</div>';
            }
            $('#option-wrap').html(optionsHtml);
          }


          function addProductToOrder(order_id) {
            var productId = $('input[name="product_id"]').val();
            var quantity = $('#quantity').val();
            var options = {};
            var allOptionsSelected = true;

            $('#option-wrap select').each(function() {

              var parts = $(this).attr('id').split('-');
              var optionId = parts[1];
              var optionValue = $(this).val();

              if (!optionValue) {
                allOptionsSelected = false;
              }

              options[optionId] = optionValue;
            });


            if (!productId || !quantity) {
              alert('{{ text_select_quantity_product }}');
              return;
            }
            if (!allOptionsSelected) {
              alert('{{ text_select_all_options }}');
              return;
            }

            var data = {
              product_id: productId,
              quantity: quantity,
              options: options
            };

            $.ajax({
              url: 'index.php?route=account/manager_list/pixselAddProduct&order_id=' + order_id,
              type: 'post',
              data: data,
              dataType: 'json',
              success: function(json) {
                if (json['success']) {
                  
                  // Renew info in modal
                  // location.reload();
                  $.ajax({
                    url: 'index.php?route=account/manager_list/edit&order_id=' + order_id,
                    type: 'GET',
                    dataType: 'html',
                    success: function(data) {
                      $('#ft-order-edit-modal').html('');
                      $('#ft-order-edit-modal').html(data);

                      $('#addProductModal').modal('hide');
                      // $('#addProductModal').remove();
                      $('.modal-backdrop:eq(1)').hide();
                      $('.modal-backdrop:eq(1)').remove();
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                      console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                    }
                  });


                } else {
                  console.log(json['error'] || 'Помилка при додаванні товару.');
                }
              },
              error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
              }
            });
          }


          function editProductToOrder(order_id) {
            var productId = $('#editProductModal input[name="product_id"]').val();
            var options = {};
            var allOptionsSelected = true;

            $('#editProductModal #option-wrap select').each(function() {

              var parts = $(this).attr('id').split('-');
              var optionId = parts[1];
              var optionValue = $(this).val();

              if (!optionValue) {
                allOptionsSelected = false;
              }

              options[optionId] = optionValue;
            });

            if (!allOptionsSelected) {
              alert('{{ text_select_all_options }}');
              return;
            }

            var data = {
              product_id: productId,
              options: options
            };

            $.ajax({
              url: 'index.php?route=account/manager_list/pixselEditProduct&order_id=' + order_id,
              type: 'post',
              data: data,
              dataType: 'json',
              success: function(json) {
                if (json['success']) {
                  // Renew info in modal
                  $.ajax({
                    url: 'index.php?route=account/manager_list/edit&order_id=' + order_id,
                    type: 'GET',
                    dataType: 'html',
                    success: function(data) {
                      $('#ft-order-edit-modal').html('');
                      $('#ft-order-edit-modal').html(data);

                      $('#editProductModal').modal('hide');
                      // $('#editProductModal').remove();
                      $('.modal-backdrop:eq(1)').hide();
                      $('.modal-backdrop:eq(1)').remove();
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                      console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                    }
                  });


                } else {
                  console.log(json['error'] || 'Error edit product');
                }
              },
              error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
              }
            });
          }




          $('#addProductModal').on('hidden.bs.modal', function () {
            $('#input-product').val('');
            $('input[name="product_id"]').val('');
            $('#quantity').val(1);
            $('#option-wrap').empty();

            setTimeout(function () {
              $('.modal-backdrop:eq(1)').hide();
              $('.modal-backdrop:eq(1)').remove();
              $("body").removeClass("modal-open");
              $("body").css("padding-right", "0");
              $('#ft-order-edit-modal').css('z-index', '1050').css('height', '100%').css('position', 'fixed').css('overflow', 'auto');
              $('.modal-backdrop').css('z-index', '1042');
            }, 200);
          });

          function pixselDeleteProduct(order_id, order_product_id, product_id) {
            if (!confirm('{{ text_confirm_delete }}')) {
              return;
            }

            $.ajax({
              url: 'index.php?route=account/manager_list/pixselDeleteProduct&product_id='+product_id+'&order_id='+order_id+'&order_product_id=' + order_product_id,
              type: 'post',
              dataType: 'json',
              success: function(json) {
                if (json['success']) {
                  // location.reload();

                  $.ajax({
                    url: 'index.php?route=account/manager_list/edit&order_id=' + order_id,
                    type: 'GET',
                    dataType: 'html',
                    success: function(data) {
                      $('#ft-order-edit-modal').html('');
                      $('#ft-order-edit-modal').html(data);
                    },
                    error: function(xhr, ajaxOptions, thrownError) {
                      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                    }
                  });
                } else {
                  console.log('Сталася помилка при видаленні товару');
                }
              },
              error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
              }
            });
          }


          $(document).ready(function() {


            $('.product-qty input[type="number"]').on('blur', function() {
              $(this).val($(this).val().replace(/[^0-9]/g, ''));
              if ($(this).val() < 1) $(this).val(1);
            });

            $('.product-qty').on('click', '.btn-update', function() {
              var $btn = $(this);
              var productId = $(this).data('id');
              var input = $(this).siblings('input[type="number"]');
              var currentValue = parseInt(input.val());
              var order_id = $('#save_edit_fileds').data('orderid');

              $.ajax({
                url: 'index.php?route=account/manager_list/changeQtyProduct&order_id=' + order_id + '&order_product_id=' + productId + '&quantity=' + currentValue,
                type: 'GET',
                beforeSend: function() {
                  $btn.button('loading');
                },
                success: function(response) {
                  if(response.success) {
                    // location.reload();

                    $.ajax({
                      url: 'index.php?route=account/manager_list/edit&order_id=' + order_id,
                      type: 'GET',
                      dataType: 'html',
                      success: function(data) {
                        $('#ft-order-edit-modal').html('');
                        $('#ft-order-edit-modal').html(data);
                      },
                      error: function(xhr, ajaxOptions, thrownError) {
                        console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                      }
                    });
                  }else{
                    console.log(response.error);
                  }
                },
                error: function(xhr, status, error) {
                  console.error('Помилка AJAX запиту', error);
                },
                complete: function() {
                  $btn.button('reset');
                }
              });

            });

          });

        </script>

