{{ header }}
<div id="product-search" class="container">
  <div class="row">
		{% if column_left or menu_open %}
		<div class="col-12 col-sm col-lg-3 order-lg-1 col-aside">
			{% if menu_open %}
			<div class="menu-holder d-none d-lg-block mb-3 mt-n3"></div>
      <script>var menu_holder_height = function() { document.querySelector('.menu-holder').style.height = document.querySelector('.category-menu-list').offsetHeight + 'px' }; menu_holder_height();</script>
			{% endif %}
			{{ column_left }}
		</div>
		{% endif %}
		{% if column_right %}
		<div class="col-12 col-sm col-lg-3 order-lg-3 col-aside">
			{{ column_right }}
		</div>
		{% endif %}
     <div id="content" class="col-12 col-lg order-lg-2">
			{{ content_top }}
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb p-0 mb-3 bg-transparent" itemscope itemtype="http://schema.org/BreadcrumbList">
          {% for breadcrumb in breadcrumbs %}
          {% if loop.index == 1 %}
          <li class="breadcrumb-item p-0" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
            <a class="text-dark" href="{{ breadcrumb.href }}"  itemprop="item">
              <meta itemprop="name" content="{{ g_text_home }}" />
            	<svg class="ft-icon-18 d-block" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            		<path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
            	</svg>
            </a>
            <meta itemprop="position" content="{{ loop.index }}" />
          </li>
          {% elseif breadcrumbs|length != loop.index %}
          <li class="breadcrumb-item p-0" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
            <a class="text-dark" href="{{ breadcrumb.href }}" itemprop="item">
              <span itemprop="name">{{ breadcrumb.text }}</span>
            </a>
            <meta itemprop="position" content="{{ loop.index }}" />
          </li>
          {% else %}
          <li class="breadcrumb-item p-0 active">
            <span>{{ breadcrumb.text }}</span>
          </li>
          {% endif %}
          {% endfor %}
        </ol>
      </nav>
			<h1 class="h2 mb-4">{{ heading_title }}</h1>
			<div class="mb-4">
  			<label class="d-none">{{ entry_search }}</label>
  			<div class="row form-row mb-2">
  				<div class="col-12 col-md-7 mb-2">
  					<input type="text" name="search" value="{{ search }}" placeholder="{{ text_keyword }}" id="input-search" class="form-control" />
  				</div>
  				<div class="col mb-2">
  				<select name="category_id" class="form-control">
  					<option value="0">{{ text_category }}</option>
  					{% for category_1 in categories %}
  					{% if category_1.category_id == category_id %}
  					<option value="{{ category_1.category_id }}" selected="selected">{{ category_1.name }}</option>
  					{% else %}
  					<option value="{{ category_1.category_id }}">{{ category_1.name }}</option>
  					{% endif %}
  					{% for category_2 in category_1.children %}
  					{% if category_2.category_id == category_id %}
  					<option value="{{ category_2.category_id }}" selected="selected">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ category_2.name }}</option>
  					{% else %}
  					<option value="{{ category_2.category_id }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ category_2.name }}</option>
  					{% endif %}
  					{% for category_3 in category_2.children %}
  					{% if category_3.category_id == category_id %}
  					<option value="{{ category_3.category_id }}" selected="selected">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ category_3.name }}</option>
  					{% else %}
  					<option value="{{ category_3.category_id }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ category_3.name }}</option>
  					{% endif %}
  					{% endfor %}
  					{% endfor %}
  					{% endfor %}
  				</select>
  				</div>
  				<div class="col-auto ml-auto">
  					<input type="button" value="{{ button_search }}" id="button-search" class="btn btn-block btn-primary px-4" />
  				</div>
  			</div>
  			<div class="custom-control custom-checkbox custom-control-inline">
  				{% if sub_category %}
  				<input class="custom-control-input" type="checkbox" name="sub_category" value="1" id="sub_category" checked="checked" />
  				{% else %}
  				<input class="custom-control-input" type="checkbox" name="sub_category" value="1" id="sub_category" />
  				{% endif %}
  				<label class="custom-control-label" for="sub_category">
  					{{ text_sub_category }}
  				</label>
  			</div>
  			<div class="custom-control custom-checkbox custom-control-inline">
  				{% if description %}
  				<input class="custom-control-input" type="checkbox" name="description" value="1" id="description" checked="checked" />
  				{% else %}
  				<input class="custom-control-input" type="checkbox" name="description" value="1" id="description" />
  				{% endif %}
  				<label class="custom-control-label" for="description">
  					{{ entry_description }}
  				</label>
  			</div>
			</div>
			<hr>
      <h2 class="mb-4 d-none">{{ text_search }}</h2>
      {% if products %}
      <div class="mb-3">
        <div class="row no-gutters">
          <div class="col-auto col-sm-auto order-sm-1">
            <h1 class="h2-sm h2 mb-2">{{ heading_title }}</h1>
          </div>
          <div class="col-auto col-sm-auto ml-auto order-sm-3">
            <div class="btn-group ml-sm-2">
              <button type="button" id="ft-price-view" class="btn d-none d-lg-block btn-light px-2 border" title="{{ button_price }}" onclick="products_view('price')">
                <svg class="d-block ft-icon-18 text-gray-600 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 10.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zm0-6c-.83 0-1.5.67-1.5 1.5S3.17 7.5 4 7.5 5.5 6.83 5.5 6 4.83 4.5 4 4.5zm0 12c-.83 0-1.5.68-1.5 1.5s.68 1.5 1.5 1.5 1.5-.68 1.5-1.5-.67-1.5-1.5-1.5zM7 19h14v-2H7v2zm0-6h14v-2H7v2zm0-8v2h14V5H7z"/>
                </svg>
              </button>
              {% if type_customer == 2 or customer_gid == 4 %}
              <button type="button" id="ft-list-view-admin" class="btn btn-light px-2 border {% if view_default == 'list_admin' %}active{% endif %}" title="{{ button_list }}" onclick="products_view('list_admin')">
                <span class="d-block ft-icon-18 text-gray-600 darker-on-hover">$</span>
              </button>
              {% endif %}
              <button type="button" id="ft-list-view" class="btn btn-light px-2 border {% if view_default == 'list' %}active{% endif %}" title="{{ button_grid }}" onclick="products_view('list')">
                <svg class="d-block ft-icon-18 text-gray-600 darker-on-hover" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
              </button>
              <button type="button" id="ft-big-grid-view" class="btn btn-light px-2 border {% if view_default == 'big_grid' %}active{% endif %}" title="{{ button_grid }}" onclick="products_view('big_grid')">
                <svg class="d-block ft-icon-18 text-gray-600 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M 2 3 L 2 11 L 7 11 L 7 3 L 2 3 z M 9 3 L 9 11 L 15 11 L 15 3 L 9 3 z M 17 3 L 17 11 L 22 11 L 22 3 L 17 3 z M 2 13 L 2 21 L 7 21 L 7 13 L 2 13 z M 9 13 L 9 21 L 15 21 L 15 13 L 9 13 z M 17 13 L 17 21 L 22 21 L 22 13 L 17 13 z"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="col col-sm-auto ml-sm-auto order-sm-2 d-none">
            <div class="form-group input-group input-group-sm mb-0">
              <div class="input-group ml-2">
                <div class="input-group-prepend">
                  <span class="input-group-text px-2 bg-light" title="{{ text_limit }}">
                    <svg class="d-block ft-icon-18 text-gray-500" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3 5H1v16c0 1.1.9 2 2 2h16v-2H3V5zm18-4H7c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm0 16H7V3h14v14z"/>
                    </svg>
                  </span>
                </div>
                <select id="input-limit" class="form-control custom-select" onchange="location = this.value;" aria-label="{{ text_limit }}">
                  {% for limits in limits %}
                  {% if limits.value == limit %}
                  <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
                  {% else %}
                  <option value="{{ limits.href }}">{{ limits.text }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>
          </div>
          <div class="col-12 col-sm-auto order-sm-1 mt-2 mt-sm-0 d-none">
            <div class="form-group input-group input-group-sm mb-0">
              <div class="input-group">
                <div class="input-group-prepend">
                  <span class="input-group-text px-2 bg-light" title="{{ text_sort }}">
                    <svg class="d-block ft-icon-18 text-gray-500" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/>
                    </svg>
                  </span>
                </div>
                <select id="input-sort" class="form-control custom-select" onchange="location = this.value;" aria-label="{{ text_sort }}">
                  {% for sorts in sorts %}
                  {% if sorts.value == '%s-%s'|format(sort, order) %}
                  <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
                  {% else %}
                  {% if not (catalog_mode and ('p.price' in sorts.value)) %}
                  <option value="{{ sorts.href }}">{{ sorts.text }}</option>
                  {% endif %}
                  {% endif %}
                  {% endfor %}
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="products-container">

        {% if view_default == 'list' %}
        <div class="list row form-row row-cols-1">
        {% endif  %}

        {% if view_default == 'grid' %}
        <div class="grid row form-row row-cols-2 row-cols-md-3 {% if column_right and (column_left or menu_open) %}row-cols-lg-2 row-cols-xl-3 row-cols-xxl-4{% elseif column_right or (column_left or menu_open) %}row-cols-xl-4 row-cols-xxl-5 {% else %}row-cols-lg-4 row-cols-xl-5 row-cols-xxl-6{% endif %}">
        {% endif  %}

        {% if view_default == 'big_grid' %}
        <div class="big_grid row form-row row-cols-1 row-cols-sm-2 {% if column_right and (column_left or menu_open) %}row-cols-lg-1 row-cols-xl-2 row-cols-xxl-3{% elseif column_right or (column_left or menu_open) %}row-cols-xl-3 row-cols-xxl-4 {% else %}row-cols-lg-3 row-cols-xl-3 row-cols-xxl-3{% endif %}">
        {% endif  %}

        {% for product in products %}
        <div class="col product-item d-flex mb-2">
          <div class="bg-white w-100 d-flex flex-column border rounded shadow-sm mb-1">
            <div class="product-image position-relative text-center px-2 px-sm-3 pt-2 pb-2">

              {% if product.dop_images %}
              <div id="gallery_{{ product.product_id }}" class="dop-image">
                {% for key_img, dop_image in product.dop_images %}
                  <a href="{{ dop_image.popup }}" data-fancybox="gallery_{{ product.product_id }}" data-caption="{{ product.name }}">
                    <img class="img-fluid" data-num="{{ key_img }}" src="{{ dop_image.thumb }}" width="{{ pimg_w }}" height="{{ pimg_h }}" alt="{{ product.name }}">
                  </a>
                {% endfor %}
              </div>
              {% endif %}

              <div class="main-image">
                <span role="button" data-px-gallery="{{ product.product_id }}">
                  <div class="d-inline-block position-relative">
                    <img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-fluid">
                  </div>
                </span>
                 {% if product.stickers %}
                <ul class="list-unstyled position-absolute t-0 l-0 ml-3 mt-2 text-left">
                  {% for sticker in product.stickers %}
                  <li><span class="{{ sticker.class }}">{{ sticker.text }}</span></li>
                  {% endfor %}
                </ul>
                {% endif %}
              </div>
            </div>
            <div class="px-caption d-flex flex-column">
            <div class="product-description px-2 px-sm-3 pt-2 pb-1">
              <div class="product-name">
                {#<span role="button" data-px-gallery="{{ product.product_id }}" class="text-dark h6 font-weight-normal line-clamp-2">{{ product.name }}</span>#}
                <a href="{{ product.href }}" class="text-dark h6 font-weight-bold line-clamp-2">{{ product.name }}</a>
              </div>

              {% if product.additional_fields %}
              <ul class="product-fields list-unstyled mb-2">
                {% for field in product.additional_fields %}
                <li><small class="d-block text-muted">{{ field.title }} {{ field.text }}</small></li>
                {% endfor %}
              </ul>
              {% endif %}

              <div class="product-text d-none font-weight-light text-secondary mb-3">{{ product.description }}</div>
            </div>

            {% if product.options %}
            <div class="product-options">
              {% for  option in product.options %}
                {% for key_opt, option_value in option.product_option_value %}
                  <div class="option-item d-flex">
                    <div class="option-name">{{ option_value.name }}<span class="option-qty {% if option_value.option_status == 1 %}in_stock{% else %}out_stock{% endif %}"></span></div>
                    <div class="option-price">
                      {% if key_opt == 0 %}
                      <div class="col-head-price {% if pixsel_tax_status %}tax-col-head{% endif %}">{{ text_head_price }}</div>
                      {% endif %}
                      
                      {#{% if product.price %}
                          {% if not product.special %}
                             {% if product.retail_price %}
                              <span class="old-price d-inline-block">{{ product.retail_price }}</span>
                              {% endif %}
                             {{ product.price }}
                          {% else %}
                             <span class="old-price d-inline-block">{{ product.price }}</span>
                             <span class="new-price d-inline-block">{{ product.special }}</span>
                          {% endif %}
                      {% endif %}#}
                      {% if product.price %}
                          {% if not product.special %}
                             {% if product.retail_price %}
                              <span class="old-price d-inline-block">{{ product.retail_price }}</span>
                              {% endif %}
                               {{ product.price }}
                               {% if pixsel_tax_status %}
                                <span class="netto-price d-inline-block">{{ product.tax_price }} {{ lang_without }}</span>
                              {% endif %}
                          {% else %}
                             <span class="old-price d-inline-block">{{ product.price }}</span>
                             <span class="new-price d-inline-block">{{ product.special }}</span>
                          {% endif %}
                      {% endif %}
                    </div>

                    {#{% if product.prices %}
                      {% for ap_key, customer_group_price in product.prices %}
                        <div class="option-price-group">
                          {% if key_opt == 0 %}
                            <div class="col-head-price">{{ customer_group_price.name }}</div>
                          {% endif %}
                          {% if type_customer == 2 %}
                            <span data-po-id="{{ option['product_option_id'] }}" data-pov-id="{{ option_value['product_option_value_id'] }}" data-product-id="{{ product['product_id'] }}" data-cg-id="{{ customer_group_price.customer_group_id }}" onclick="addToCartWorker(this)" class="cg-price font-weight-bold">{{ customer_group_price.price }}</span>
                          {% else %}
                            <span class="font-weight-bold">{{ customer_group_price.price }}</span>
                          {% endif %}
                        </div>
                      {% endfor %}
                    {% endif %}#}

                    {% if product.prices %}
                      {% for ap_key, customer_group_price in product.prices %}
                        <div class="option-price-group">
                          {% if key_opt == 0 %}
                            <div class="col-head-price" data-full-text="{{ customer_group_price.name }}" data-short-text="{{ customer_group_price.name | slice(0, 6) }}"></div>
                          {% endif %}
                          {% if type_customer == 2 %}
                            <span data-po-id="{{ option['product_option_id'] }}" data-pov-id="{{ option_value['product_option_value_id'] }}" data-product-id="{{ product['product_id'] }}" data-cg-id="{{ customer_group_price.customer_group_id }}" onclick="addToCartWorker(this)" class="cg-price font-weight-bold">{{ customer_group_price.price }}</span>
                             {% if pixsel_tax_status %}
                                <span class="netto-price d-inline-block">({{ customer_group_price.tax_price }} {{ lang_without }})</span>
                            {% endif %}
                          {% else %}
                            <span class="font-weight-bold">{{ customer_group_price.price }}</span>
                            {% if pixsel_tax_status %}
                                <span class="netto-price d-inline-block">({{ customer_group_price.tax_price }} {{ lang_without }})</span>
                            {% endif %}
                          {% endif %}
                        </div>
                      {% endfor %}
                    {% endif %}

                    <div class="option-sku">
                      {% if key_opt == 0 %}
                      <div class="col-head-sku">{{ text_sku_opt }}</div>
                      {% endif %}
                      {{ option_value.pixsel_sku }}</div>
                    {% if option_value.option_status == 1 %}
                      <div class="option-text-qty in_stock">{{ text_instock }}</div>
                    {% else %}
                     <div class="option-text-qty out_stock">{{ text_out_stock }}</div>
                   {% endif %}
                  </div>
                {% endfor %}
              {% endfor %}
            </div>
            {% endif %}

            <div class="product-controls mt-auto px-2 px-sm-3 pb-2 pb-sm-3">
              {% if (catalog_mode and not hide_price) or not catalog_mode %}
              {% if product.price %}
              <div class="price">
                 {% if product.retail_price %}
                  <span class="old-price d-inline-block">{{ product.retail_price }}</span>
                  {% endif %}
                {% if not product.special %}
                <div class="h6 mb-1">
                  {% if pixsel_tax_status %}
                    <span class="text-price-bruto">{{ text_head_price }}</span>
                  {% endif %}
                  {{ product.price }}
                  {% if pixsel_tax_status %}
                    <span class="netto-price d-inline-block">{{ product.tax_price }} {{ lang_without }}</span>
                  {% endif %}
                </div>
                {% else %}
                <div class="h6 mb-1">
                  <s class="d-inline-block text-danger font-weight-light">{{ product.price }}</s>
                  <span class="d-inline-block">{{ product.special }}</span>
                </div>
                {% endif %}
                {% if product.tax %}
                <small class="font-weight-light text-muted d-block">{{ text_tax }} {{ product.tax }}</small>
                {% endif %}
              </div>
              {% endif %}
              {% endif %}

              {% if review_status %}
              <div class="product-review d-flex align-items-center {% if (catalog_mode and not hide_price) or not catalog_mode %} mt-2 {% endif %}">
                <div class="d-flex mr-2">
                  {% for i in 1..5 %}
                  {% if product.rating < i %}
                  <svg class="d-block ft-icon-18 text-gray-400 m-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22 9.24l-7.19-.62L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.63-7.03L22 9.24zM12 15.4l-3.76 2.27 1-4.28-3.32-2.88 4.38-.38L12 6.1l1.71 4.04 4.38.38-3.32 2.88 1 4.28L12 15.4z"/>
                  </svg>
                  {% else %}
                  <svg class="d-block ft-icon-18 text-warning m-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                  {% endif %}
                  {% endfor %}
                </div>
                {% if product.reviews_href %}
                <a class="d-block text-dark text-nowrap text-truncate w-auto" href="{{ product.reviews_href }}">
                  <small>{{ product.reviews }}</small>
                </a>
                {% else %}
                <span class="d-block text-secondary text-nowrap text-truncate text-gray-500 w-auto">
                  <small>{{ product.reviews }}</small>
                </span>
                {% endif %}
              </div>
              {% endif %}
              {% if catalog_stok_status and not catalog_mode %}
              <small class="d-block {% if product.quantity <= 0 %}text-danger{% else %}text-success{% endif %} my-2">
                <span class="row no-gutters align-items-center">
                  <span class="col-auto">
                    <svg class="ft-icon d-block mr-1" width="12" height="12" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="12" cy="12" r="8"/>
                    </svg>
                  </span>
                  <span class="col">
                    {{ product.stock }}
                  </span>
                </span>
              </small>
              {% endif %}
              <div class="{% if qview_status or fastorder_status %}d-flex d-md-inline-flex{% endif %} dropup mt-2">

                {% if not catalog_mode %}
                <button type="button" class="btn btn-danger btn-cart-add py-2 px-2 pl-4 pr-4" onclick="cart.add('{{ product.product_id }}');" {% if product.quantity <=0 and disable_btn_status %}disabled{% endif %}>
                  <span class="row no-gutters align-items-center justify-content-center flex-nowrap">
                    <span class="col-auto">
                      <svg class="d-block ft-icon-18 notfil" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                      </svg>
                    </span>
                    <span class="col-auto">
                      <span class="text-truncate mx-2">{% if product.quantity <=0 and disable_btn_status %}{{ disable_btn_text }}{% else %}{{ button_cart }}{% endif %}</span>
                    </span>
                  </span>
                </button>

                {% if qview_status %}
                <button type="button" class="btn btn-light border btn-qview-add py-2 px-2 pl-2 pr-2 ml-2" title="{{ g_text_qview }}" onclick="ft_qview('{{ product.product_id }}')">
                  <svg class="d-block ft-icon-24 text-gray-500 darker-on-hover mx-auto" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg">
                    <path fill="currentColor" xmlns="http://www.w3.org/2000/svg" d="M480.091-336.924q67.985 0 115.485-47.59 47.5-47.591 47.5-115.577 0-67.985-47.59-115.485-47.591-47.5-115.577-47.5-67.985 0-115.485 47.59-47.5 47.591-47.5 115.577 0 67.985 47.59 115.485 47.591 47.5 115.577 47.5ZM480-392q-45 0-76.5-31.5T372-500q0-45 31.5-76.5T480-608q45 0 76.5 31.5T588-500q0 45-31.5 76.5T480-392Zm.055 171.999q-137.977 0-251.439-76.115Q115.155-372.231 61.54-500q53.615-127.769 167.022-203.884 113.406-76.115 251.383-76.115t251.439 76.115Q844.845-627.769 898.46-500q-53.615 127.769-167.022 203.884-113.406 76.115-251.383 76.115ZM480-500Zm0 220q113 0 207.5-59.5T832-500q-50-101-144.5-160.5T480-720q-113 0-207.5 59.5T128-500q50 101 144.5 160.5T480-280Z"></path>
