{#<div id="category-wall-{{ module }}" class="category-wall row no-gutters row-cols-2 row-cols-sm-3 row-cols-lg-5 row-cols-xxl-6  mb-3 mx-n2">#}
<div id="category-wall-{{ module }}" class="category-wall row no-gutters row-cols-4 row-cols-sm-5 row-cols-md-6 row-cols-lg-8 row-cols-xxl-8  mb-3 mx-n2">
{% for category in categories %}
<div class="col mb-3">
	{#<div class="h-100 position-relative card card-body p-3 mx-2 overflow-hidden {% if category.active %}border-primary{% endif %}">#}
	<div class="position-relative card card-body p-0 pb-1 mx-2 overflow-hidden {% if category.active %}border-primary{% endif %}">
		<a class="text-dark text-decoration-none  text-center " {% if category.children and click_action == 1 %}data-toggle="collapse" href="#subcategory-wall-{{ category.category_id }}-{{ module }}"{% else %}href="{{ category.href }}"{% endif %}>
			<div class="d-inline-block position-relative mt-3 mb-2">
				{% if category.svg is not empty %}
					{# <div class="d-block mt-2">{{ category.svg|raw }}</div> #}
					<svg class="d-block img-fluid" width="{{ category.img_width }}" height="{{ category.img_height }}" xmlns="http://www.w3.org/2000/svg"></svg>
					<img src="/image/{{ category.svg }}" width="{{ category.img_width }}" height="{{ category.img_height }}" alt="" class="position-absolute t-0 l-0 img-fluid d-block w-auto">
				{% else %}
					<svg class="d-block img-fluid" width="{{ category.img_width }}" height="{{ category.img_height }}" xmlns="http://www.w3.org/2000/svg"></svg>
					<img src="{{ category.thumb }}" alt="" {% if category.thumb2x %}srcset="{{ category.thumb }} 1x, {{ category.thumb2x }} 2x, {{ category.thumb3x }} 3x, {{ category.thumb4x }} 4x"{% endif %} class="position-absolute t-0 l-0 img-fluid d-block w-auto">
				{% endif %}
			</div>
			<div class="h6 d-block mb-0 mt-0 wc-name">{{ category.name }}</div>
		</a>
		{% if category.children and click_action == 1 %}
		<div class="collapse w-100 position-absolute b-0 l-0 z-index-2" id="subcategory-wall-{{ category.category_id }}-{{ module }}" data-parent="#category-wall-{{ module }}">
			<div class="bg-white border-top shadow px-3 pb-2 pt-2 rounded-0 {% if category.active %}border-primary{% endif %}">
				<ul class="list-unstyled m-0">
					{% for child in category.children %}
					<li class="mt-1 d-block"><a class="text-dark line-clamp-1" href="{{ child.href }}">{{ child.name }}</a></li>
					{% endfor %}
					<li><hr class="my-2 mx-n3"></li>
					<li class="d-block bg-light mx-n3 my-n2 px-3 py-2"><a class="text-dark text-decoration-none line-clamp-1" href="{{ category.href }}">{{ g_text_all }}</a></li>
				</ul>
				<a class="d-block position-absolute t-0 r-0 p-1 rounded-circle m-1" data-toggle="collapse" href="#subcategory-wall-{{ category.category_id }}-{{ module }}">
					<svg class="d-block ft-icon-18 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
					</svg>
				</a>
			</div>
		</div>
		{% endif %}
	</div>
</div>
{% endfor %}
</div>
<div class="col-12 col-lg row mb-5">
	<button type="button" class="btn btn-catwall-showhide py-1 px-2 pl-md-1 pr-md-2 btn-light">
		<span class="row no-gutters align-items-center justify-content-center flex-nowrap">
			<span class="col-auto">
				<span class="text-truncate mx-2 ">{{ button_showall }}</span>
			</span>
			<span class="col-auto">
<svg class="d-block ft-icon-18 m-0 text-gray-500" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 487.23 487.23" style="enable-background:new 0 0 487.23 487.23;"
	 xml:space="preserve">
		<path d="M55.323,203.641c15.664,0,29.813-9.405,35.872-23.854c25.017-59.604,83.842-101.61,152.42-101.61
			c37.797,0,72.449,12.955,100.23,34.442l-21.775,3.371c-7.438,1.153-13.224,7.054-14.232,14.512
			c-1.01,7.454,3.008,14.686,9.867,17.768l119.746,53.872c5.249,2.357,11.33,1.904,16.168-1.205
			c4.83-3.114,7.764-8.458,7.796-14.208l0.621-131.943c0.042-7.506-4.851-14.144-12.024-16.332
			c-7.185-2.188-14.947,0.589-19.104,6.837l-16.505,24.805C370.398,26.778,310.1,0,243.615,0C142.806,0,56.133,61.562,19.167,149.06
			c-5.134,12.128-3.84,26.015,3.429,36.987C29.865,197.023,42.152,203.641,55.323,203.641z"/>
		<path d="M464.635,301.184c-7.27-10.977-19.558-17.594-32.728-17.594c-15.664,0-29.813,9.405-35.872,23.854
			c-25.018,59.604-83.843,101.61-152.42,101.61c-37.798,0-72.45-12.955-100.232-34.442l21.776-3.369
			c7.437-1.153,13.223-7.055,14.233-14.514c1.009-7.453-3.008-14.686-9.867-17.768L49.779,285.089
			c-5.25-2.356-11.33-1.905-16.169,1.205c-4.829,3.114-7.764,8.458-7.795,14.207l-0.622,131.943
			c-0.042,7.506,4.85,14.144,12.024,16.332c7.185,2.188,14.948-0.59,19.104-6.839l16.505-24.805
			c44.004,43.32,104.303,70.098,170.788,70.098c100.811,0,187.481-61.561,224.446-149.059
			C473.197,326.043,471.903,312.157,464.635,301.184z"/>
</svg>
			</span>
		</span>
	</button>
</div>
<script>
	function getRowSize(cssSelector) {
		var firstTop = document.querySelector( cssSelector ).offsetTop;
		var rowArray = Array.prototype.filter.call(document.querySelectorAll( cssSelector ), function(element) {
			if( element.offsetTop == firstTop ) return element;
		});
		return rowArray.length;
	}

	function updateCatwall() {
		if (!$('.btn-catwall-showhide').hasClass('onclose')) {
			var windowWidth = $(window).width();
			var showLines;

			if ($(window).width() < 768) {
				showLines = 1;
			} else {
				showLines = 2;
			}

			var catwallLines = getRowSize('.category-wall .col');
			var showItems = catwallLines * showLines;

			$('.category-wall .col').each(function (index) {
				$(this).toggleClass('d-none', index >= showItems);
			});
		}
	}

	$(document).ready(function () {
     updateCatwall();
   });

	var resizeTimer;
	$(window).on('resize', function () {
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(function () {
			updateCatwall();
		}, 250);
	});

	$(document).on('click', '.btn-catwall-showhide, .wallclose', function(){
		if ($(window).width() < 768) {
			showLines = 1;
		} else {
			showLines = 2;
		}

		var catwallLines = getRowSize('.category-wall .col');
		var showItems = catwallLines * showLines;

		if ($('.btn-catwall-showhide').hasClass('onclose')) {

			$('.btn-catwall-showhide').removeClass('onclose');

			$('.wallclose svg').addClass('d-none');

			$('.category-wall .col').each(function() {
				var el_index = $(this).index()+1;
				if (el_index > showItems) {
					$(this).addClass('d-none');
				}
			});

			$('.btn-catwall-showhide').html('<span class="row no-gutters align-items-center justify-content-center flex-nowrap"><span class="col-auto"><span class="text-truncate mx-2 ">{{ button_showall }}</span>      </span><span class="col-auto"><svg class="d-block ft-icon-18 m-0 text-gray-500" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 487.23 487.23" style="enable-background:new 0 0 487.23 487.23;" xml:space="preserve"><path d="M55.323,203.641c15.664,0,29.813-9.405,35.872-23.854c25.017-59.604,83.842-101.61,152.42-101.61      c37.797,0,72.449,12.955,100.23,34.442l-21.775,3.371c-7.438,1.153-13.224,7.054-14.232,14.512c-1.01,7.454,3.008,14.686,9.867,17.768l119.746,53.872c5.249,2.357,11.33,1.904,16.168-1.205      c4.83-3.114,7.764-8.458,7.796-14.208l0.621-131.943c0.042-7.506-4.851-14.144-12.024-16.332     c-7.185-2.188-14.947,0.589-19.104,6.837l-16.505,24.805C370.398,26.778,310.1,0,243.615,0C142.806,0,56.133,61.562,19.167,149.06      c-5.134,12.128-3.84,26.015,3.429,36.987C29.865,197.023,42.152,203.641,55.323,203.641z"/><path d="M464.635,301.184c-7.27-10.977-19.558-17.594-32.728-17.594c-15.664,0-29.813,9.405-35.872,23.854      c-25.018,59.604-83.843,101.61-152.42,101.61c-37.798,0-72.45-12.955-100.232-34.442l21.776-3.369c7.437-1.153,13.223-7.055,14.233-14.514c1.009-7.453-3.008-14.686-9.867-17.768L49.779,285.089      c-5.25-2.356-11.33-1.905-16.169,1.205c-4.829,3.114-7.764,8.458-7.795,14.207l-0.622,131.943c-0.042,7.506,4.85,14.144,12.024,16.332c7.185,2.188,14.948-0.59,19.104-6.839l16.505-24.805      c44.004,43.32,104.303,70.098,170.788,70.098c100.811,0,187.481-61.561,224.446-149.059C473.197,326.043,471.903,312.157,464.635,301.184z"/></svg></span></span>');

			$([document.documentElement, document.body]).animate({
				scrollTop: $(".catwall").offset().top
			}, 800);
		} else {
			$('.btn-catwall-showhide').addClass('onclose');

			$('.wallclose svg').removeClass('d-none');

			$('.category-wall .col').each(function() {
				$(this).removeClass('d-none');
				$(this).delay(500).fadeIn();
