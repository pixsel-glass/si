			<svg class="d-none ft-icon-24 m-0 text-gray-500" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="m437.019 74.98a256 256 0 0 0 -362.038 362.04 256 256 0 0 0 362.038-362.04zm-22.627 339.413a224.254 224.254 0 0 1 -316.784 0c-87.337-87.338-87.337-229.448 0-316.786s229.446-87.336 316.784 0 87.337 229.448 0 316.786zm-50.913-243.246-84.852 84.853 82.206 82.206a16 16 0 1 1 -22.627 22.627l-82.206-82.206-84.853 84.852a16 16 0 0 1 -22.626-22.626l84.852-84.853-82.206-82.206a16 16 0 0 1 22.627-22.627l82.206 82.206 84.853-84.852a16 16 0 0 1 22.626 22.626z"/></svg>
