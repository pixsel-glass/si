<div class="card filter-pixel-main mb-3 mt-3">
	<div class="card-header border-0 px-0">
		<div class="row no-gutters row-cols-1 align-items-center pad-4 filterpixsel">
			<div class="col col-12 text-center">
				<div class="marklogo_top brand">
					{% if category_svg is not empty %}
						<img src="{{ category_svg }}" alt="" width="100" height="100" class="img-fluid d-block">
					{% else %}
						<img src="{{ category_thumb_top }}" width="100" height="100" alt="" class="img-fluid d-block w-auto">
					{% endif %}
				</div>
			</div>
			<div class="col col-12 mb-4">
				<label class="filter-listing__label" for="filter_mark">{{ text_label_mark }}</label>
				<div class="input-group">
					<div class="input-group-prepend border-igp">
						<div class="input-group-icon d-flex pl-2 pr-2">
							<div class="marklogo brand">
								{% if category_svg is not empty %}
									<img src="{{ category_svg }}" alt="" width="50" height="50" class="img-fluid d-block">
								{% else %}
									<img src="{{ category_thumb }}" width="50" height="50" alt="" class="img-fluid d-block w-auto">
								{% endif %}
							</div>
						</div>
					</div>
					<select name="filter_mark" id="filter_mark" class="form-control">
						<option value="">{{ text_select_mark }}</option>
						{% for mark_value in marks %}
							<option value="{{ mark_value.category_id }}" data-href="{{ mark_value.href }}" {% if mark_value.category_id == category_id %}selected="selected"{% endif %}>{{ mark_value.name }}</option>
						{% endfor %}
					</select>
				</div>
			</div>
			<div class="col col-12 mb-4">
				<label class="filter-listing__label" for="filter_model">{{ text_label_model }}</label>
				<div class="input-group">
					<div class="input-group-prepend border-igp">
						<div class="input-group-icon d-flex pl-2 pr-2">
