							</svg>
						</div>
					</div>
					<select name="filter_model" id="filter_model" class="form-control">
						<option value="">{{ text_select_model }}</option>
						{% for model_value in models %}
						<option value="{{ model_value.category_id }}" {% if model_value.category_id == subcategory_id %}selected="selected"{% endif %}>{{ model_value.name }}</option>
						{% endfor %}
					</select>
				</div>
			</div>
			<div class="col col-12 mb-4">
				<label class="filter-listing__label" for="filter_year">{{ text_label_year }}</label>
				<div class="input-group">
					<div class="input-group-prepend border-igp">
						<div class="input-group-icon d-flex pl-3 pr-3">
							<svg class="icon-filter-year" width="31" height="31" viewBox="0 0 31 31" fill="none" xmlns="http://www.w3.org/2000/svg">
