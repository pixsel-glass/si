<div class="container position-relative">
	<div class="border rounded-lg px-3 p-4 pt-5 bg-white">
		<div class="row">
			{% if informations %}
			<div class="col-12 col-sm-4 col-lg-2">
				<div class="mb-3 mb-lg-3">
					<div class="row no-gutters">
						<div class="col">
							<div class="h5 mb-0">
								{{ text_information }}
							</div>
						</div>
						<div class="col-auto">
							<a href="#collapse-info" class="d-block d-sm-none" data-toggle="collapse">
								<svg class="toggle-hidden ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
								</svg>
								<svg class="toggle-shown ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path d="M19 13H5v-2h14v2z"/>
								</svg>
							</a>
						</div>
					</div>
					<div class="collapse show collapse-xs" id="collapse-info">
						{{ ft_links_footer }}
						{% if is_mobile == 1 %}{{ ft_hlinks }}{% endif %}
					</div>
				</div>
				<hr class="d-sm-none">
			</div>
			{% endif %}
			{% if is_mobile == 0 %}
			<div class="col-12 col-sm-4 col-lg-3 mr-lg-auto">
				{{ ft_hlinks }}
			</div>
			{% endif %}
			<div class="col-12 col-sm-4 col-lg-2">
				<div class="mb-3 mb-lg-3">
					<div class="row no-gutters">
						<div class="col">
							<div class="h5 mb-0">
								{{ text_language }}
							</div>
						</div>
						<div class="col-auto">
							<a href="#collapse-language" class="d-block d-sm-none collapsed" data-toggle="collapse">
								<svg class="toggle-hidden ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
								</svg>
								<svg class="toggle-shown ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path d="M19 13H5v-2h14v2z"/>
								</svg>
							</a>
						</div>
					</div>
					<div class="collapse collapse-xs d-sm-block" id="collapse-language">
						<ul class="list-unstyled mb-0 mt-3">
							{% for language in languages %}
								{% if language.code == language_select %}
									<li class="row no-gutters pb-1">
										<span class="col-auto">
											<svg class="ft-icon-18 d-block text-gray-500 darker-on-hover mr-2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
												<path d="M8.59 16.34l4.58-4.59-4.58-4.59L10 5.75l6 6-6 6z"></path>
											</svg>
										</span>
										<span class="col">
											<button class="p-0 d-flex text-dark language-select btn btn-link btn-block language-select font-weight-bold" onclick="$('button[data-lang-id={{ language.language_id }}]').trigger('click');">{{ language.name }}</button>
										</span>
									</li>
								{% else %}
									<li class="row no-gutters pb-1">
										<span class="col-auto">
											<svg class="ft-icon-18 d-block text-gray-500 darker-on-hover mr-2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
												<path d="M8.59 16.34l4.58-4.59-4.58-4.59L10 5.75l6 6-6 6z"></path>
											</svg>
										</span>
										<span class="col">
											<button class="p-0 d-flex text-dark language-select btn btn-link btn-block language-select" onclick="$('button[data-lang-id={{ language.language_id }}]').trigger('click');">{{ language.name }}</button>
										</span>
									</li>
								{% endif %}
							{% endfor %}
						</ul>
					</div>
				</div>
				<hr class="d-sm-none">
			</div>

			<div class="col-12 col-sm-4 col-lg-2">
				<div class="mb-3 mb-lg-3">
					<div class="show d-sm-block" id="collapse-payicons">
						{% if pay_icons and pay_icons_status %}
						<div class="col-12 col-lg">
							<div class="d-table w-100 h-100">
								<div class="d-table-cell w-100 h-100 align-middle">
									<hr class="d-lg-none">
									<ul class="text-left text-lg-center m-0 p-0 f-pay-icons">
										{% for pay_icon in pay_icons %}
										<li class="list-style-none mt-2">
											{% if pay_icon.link %}
											<a href="{{ pay_icon.link }}">
												<img src="{{ pay_icon.image }}" {% if pay_icon.image2x %}srcset="{{ pay_icon.image }} 1x, {{ pay_icon.image2x }} 2x, {{ pay_icon.image3x }} 3x, {{ pay_icon.image4x }} 4x"{% endif %} alt="{{ pay_icon.title }}" class="img-fluid">
											</a>
											{% else %}
												<img src="{{ pay_icon.image }}" {% if pay_icon.image2x %}srcset="{{ pay_icon.image }} 1x, {{ pay_icon.image2x }} 2x, {{ pay_icon.image3x }} 3x, {{ pay_icon.image4x }} 4x"{% endif %} alt="{{ pay_icon.title }}" class="img-fluid">
											{% endif %}
										</li>
										{% endfor %}
									</ul>
								</div>
							</div>
						</div>
						{% endif %}
					</div>
				</div>
				<hr class="d-sm-none">
				</div>
			</div>
      		{% if not catalog_mode %}
			{#<div class="col-12 col-sm-4 col-lg-2">
				<div class="mb-3 mb-lg-3">
					<div class="row no-gutters">
						<div class="col">
							<div class="h5 mb-0">
								{{ text_currency }}
							</div>
						</div>
						<div class="col-auto">
							<a href="#collapse-currency" class="d-block d-sm-none collapsed" data-toggle="collapse">
								<svg class="toggle-hidden ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
								</svg>
								<svg class="toggle-shown ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path d="M19 13H5v-2h14v2z"/>
								</svg>
							</a>
						</div>
					</div>
					<div class="collapse collapse-xs d-sm-block" id="collapse-currency">
						<ul class="list-unstyled mb-0 mt-3">
							{{ currency }}
						</ul>
					</div>
				</div>
				<hr class="d-sm-none">
			</div>#}
      	{% endif %}
		</div>
		<hr class="d-none d-sm-block">
		<div class="row">
			<div class="col-12">
				<div class="text-secondary text-center">
					{#{% if current_language == 'en' %}
						<svg width="35px" height="25px" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--twemoji" preserveAspectRatio="xMidYMid meet" fill="#000000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path fill="#00247D" d="M0 9.059V13h5.628zM4.664 31H13v-5.837zM23 25.164V31h8.335zM0 23v3.941L5.63 23zM31.337 5H23v5.837zM36 26.942V23h-5.631zM36 13V9.059L30.371 13zM13 5H4.664L13 10.837z"></path><path fill="#CF1B2B" d="M25.14 23l9.712 6.801a3.977 3.977 0 0 0 .99-1.749L28.627 23H25.14zM13 23h-2.141l-9.711 6.8c.521.53 1.189.909 1.938 1.085L13 23.943V23zm10-10h2.141l9.711-6.8a3.988 3.988 0 0 0-1.937-1.085L23 12.057V13zm-12.141 0L1.148 6.2a3.994 3.994 0 0 0-.991 1.749L7.372 13h3.487z"></path><path fill="#EEE" d="M36 21H21v10h2v-5.836L31.335 31H32a3.99 3.99 0 0 0 2.852-1.199L25.14 23h3.487l7.215 5.052c.093-.337.158-.686.158-1.052v-.058L30.369 23H36v-2zM0 21v2h5.63L0 26.941V27c0 1.091.439 2.078 1.148 2.8l9.711-6.8H13v.943l-9.914 6.941c.294.07.598.116.914.116h.664L13 25.163V31h2V21H0zM36 9a3.983 3.983 0 0 0-1.148-2.8L25.141 13H23v-.943l9.915-6.942A4.001 4.001 0 0 0 32 5h-.663L23 10.837V5h-2v10h15v-2h-5.629L36 9.059V9zM13 5v5.837L4.664 5H4a3.985 3.985 0 0 0-2.852 1.2l9.711 6.8H7.372L.157 7.949A3.968 3.968 0 0 0 0 9v.059L5.628 13H0v2h15V5h-2z"></path><path fill="#CF1B2B" d="M21 15V5h-6v10H0v6h15v10h6V21h15v-6z"></path></g></svg>
					{% endif %}
					{% if current_language == 'lv' %}
						<svg width="35px" height="25px" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--twemoji" preserveAspectRatio="xMidYMid meet" fill="#000000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path fill="#9E3039" d="M32 5H4a4 4 0 0 0-4 4v6h36V9a4 4 0 0 0-4-4zm0 26H4a4 4 0 0 1-4-4v-6h36v6a4 4 0 0 1-4 4z"></path><path fill="#EEE" d="M0 15h36v6H0z"></path></g></svg>
					{% endif %}
					{% if current_language == 'lt' %}
						<svg width="35px" height="25px" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--twemoji" preserveAspectRatio="xMidYMid meet" fill="#000000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path fill="#006A44" d="M0 14h36v8H0z"></path><path fill="#FDB913" d="M32 5H4a4 4 0 0 0-4 4v5h36V9a4 4 0 0 0-4-4z"></path><path fill="#C1272D" d="M4 31h28a4 4 0 0 0 4-4v-5H0v5a4 4 0 0 0 4 4z"></path></g></svg>
					{% endif %}
					{% if current_language == 'et' %}
						<svg width="35px" height="25px" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--twemoji" preserveAspectRatio="xMidYMid meet" fill="#000000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path fill="#141414" d="M0 14h36v9H0z"></path><path fill="#4891D9" d="M32 5H4a4 4 0 0 0-4 4v5h36V9a4 4 0 0 0-4-4z"></path><path fill="#EEE" d="M32 31H4a4 4 0 0 1-4-4v-4h36v4a4 4 0 0 1-4 4z"></path></g></svg>
					{% endif %}#}
					{{ powered }}
				</div>
			</div>
			{#{% if pay_icons and pay_icons_status %}
			<div class="col-12 col-lg">
				<div class="d-table w-100 h-100">
					<div class="d-table-cell w-100 h-100 align-middle">
						<hr class="d-lg-none">
						<ul class="list-inline text-left text-lg-right m-0 f-pay-icons">
							{% for pay_icon in pay_icons %}
							<li class="list-inline-item mt-2">
								{% if pay_icon.link %}
								<a href="{{ pay_icon.link }}">
									<img src="{{ pay_icon.image }}" {% if pay_icon.image2x %}srcset="{{ pay_icon.image }} 1x, {{ pay_icon.image2x }} 2x, {{ pay_icon.image3x }} 3x, {{ pay_icon.image4x }} 4x"{% endif %} alt="{{ pay_icon.title }}" class="img-fluid">
								</a>
								{% else %}
									<img src="{{ pay_icon.image }}" {% if pay_icon.image2x %}srcset="{{ pay_icon.image }} 1x, {{ pay_icon.image2x }} 2x, {{ pay_icon.image3x }} 3x, {{ pay_icon.image4x }} 4x"{% endif %} alt="{{ pay_icon.title }}" class="img-fluid">
								{% endif %}
							</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			</div>
			{% endif %}#}
		</div>

	</div>
</div>
