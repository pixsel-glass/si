<div id="ft_cart">
  <button type="button" class="btn pt-0 pb-0 pr-0 shadow-none position-relative d-flex align-items-center flex-column pl-2 pr-2 pl-lg-3 pr-lg-3  position-relative" {% if not in_cart %} data-toggle="modal" {% endif %} data-target="#ft_popup_cart" data-loading="{{ text_loading }}">
		<span class="col-auto pl-0 pr-0 pl-md-2 pr-md-2">
			<svg class="d-block ft-icon-24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M18.3088 16.5559C16.8058 16.5559 15.583 17.7787 15.583 19.2817C15.583 20.7847 16.8058 22.0075 18.3088 22.0075C19.8118 22.0075 21.0346 20.7847 21.0346 19.2817C21.0346 17.7787 19.8118 16.5559 18.3088 16.5559ZM18.3088 20.372C17.7075 20.372 17.2185 19.883 17.2185 19.2817C17.2185 18.6804 17.7075 18.1914 18.3088 18.1914C18.9101 18.1914 19.3991 18.6804 19.3991 19.2817C19.3991 19.883 18.9101 20.372 18.3088 20.372Z"/>
				<path d="M22.6872 6.02081C22.5324 5.82271 22.295 5.70711 22.0434 5.70711H6.0477L5.31172 2.62774C5.22368 2.25977 4.89465 2 4.51631 2H1.81774C1.36609 1.99996 1 2.36605 1 2.8177C1 3.26936 1.36609 3.63545 1.81774 3.63545H3.87085L6.52852 14.7557C6.61656 15.124 6.94559 15.3834 7.32393 15.3834H20.0536C20.4295 15.3834 20.7571 15.1272 20.8473 14.7625L22.8372 6.72131C22.8974 6.47711 22.842 6.21901 22.6872 6.02081ZM19.4138 13.748H7.96939L6.43855 7.34261H20.9985L19.4138 13.748Z"/>
				<path d="M8.41429 16.5559C6.91125 16.5559 5.68848 17.7787 5.68848 19.2817C5.68848 20.7847 6.91129 22.0075 8.41429 22.0075C9.91728 22.0075 11.1401 20.7847 11.1401 19.2817C11.1401 17.7787 9.91728 16.5559 8.41429 16.5559ZM8.41429 20.372C7.81298 20.372 7.32396 19.883 7.32396 19.2817C7.32396 18.6804 7.81298 18.1914 8.41429 18.1914C9.0156 18.1914 9.50461 18.6804 9.50461 19.2817C9.50461 19.883 9.0156 20.372 8.41429 20.372Z"/>
			</svg>
		</span>
		<span id="ft_cart_total" class="col-auto header-buttons__totals d-flex justify-content-center align-items-center">
			{{ text_items }}
		</span>
		<span class="col-auto pl-0 pr-0 d-none d-md-block header-buttons__text mt-2">
			{{ text_cart }}
		</span>
	</button>
	<div class="modal fade" id="ft_popup_cart" tabindex="-1" role="dialog">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header no-gutters">
					<div class="col-auto">
						<div class="loading-icon mr-3">
							<div class="spinner-border ft-icon-24 m-0 text-gray-500"></div>
						</div>
						<div class="static-icon mr-3">
							<svg class="d-block ft-icon-24 m-0 text-gray-500" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path d="M22 9h-4.79l-4.38-6.56c-.19-.28-.51-.42-.83-.42s-.64.14-.83.43L6.79 9H2c-.55 0-1 .45-1 1 0 .09.01.18.04.27l2.54 9.27c.23.84 1 1.46 1.92 1.46h13c.92 0 1.69-.62 1.93-1.46l2.54-9.27L23 10c0-.55-.45-1-1-1zM12 4.8L14.8 9H9.2L12 4.8zM18.5 19l-12.99.01L3.31 11H20.7l-2.2 8zM12 13c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
							</svg>
						</div>
					</div>
					<div class="col">
						<div class="h5 modal-title">
							{{ ft_heading_title }}
						</div>
					</div>
					<div class="col-auto">
            <a href="#" class="d-block ml-2" data-dismiss="modal">
        			<svg class="d-block ft-icon-24 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        				<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
        			</svg>
        		</a>
					</div>
				</div>
				<div class="modal-body pb-2 pb-md-3">
					<div class="cart-list">
						{% if products or vouchers %}
						<div class="cart-list-product">
							{% for product in products %}
							<div class="row">
								<div class="col-auto">
									{% if product.thumb %}
									<a href="{{ product.href }}" class="ml-1 d-block position-relative border rounded overflow-hidden">
                    <svg width="{{ product.img_width }}" height="{{ product.img_height }}" class="d-block img-placeholder" viewBox="0 0 1 1" xmlns="http://www.w3.org/2000/svg"></svg>
										<img src="{{ product.thumb }}" {% if product.thumb2x %}srcset="{{ product.thumb }} 1x, {{ product.thumb2x }} 2x, {{ product.thumb3x }} 3x, {{ product.thumb4x }} 4x"{% endif %} alt="{{ product.name }}" title="{{ product.name }}" class="d-block position-absolute t-0 l-0" />
									</a>
									{% endif %}
								</div>
								<div class="col">
									<div class="row">
										<div class="col ">
											<div class="mb-2">
												<div class="row no-gutters">
													<div class="col">
														<a href="{{ product.href }}" class="text-dark"><strong>{{ product.name }}</strong></a>
														<div>
															{% if product.option %}
															{% for option in product.option %}
															<small class="d-inline-block bg-light text-secondary border-like-form pl-2 pr-2">{{ option.name }}: {{ option.value }}</small>
															{% endfor %}
															{% endif %}
															{% if product.recurring %}
															<small class="d-inline-block bg-light text-secondary border-like-form pl-2 pr-2">{{ text_recurring }}: {{ product.recurring }}</small>
															{% endif %}
														</div>
													</div>
													<div class="col-auto">
														<button type="button" class="close ml-2 mr-1 d-sm-none" onclick="cart.remove('{{ product.cart_id }}');">×</button>
													</div>
												</div>
											</div>
										</div>
										<div class="col-12 col-sm-auto">
											<div class="mr-3 mb-2 text-left text-sm-right">
												{% if pixsel_tax_status %}
													<span class="text-gray-500">{{ lang_with }}</span>
												{% endif %}
												<strong>{{ product.total }}</strong>
											</div>
											<div class="form-row mr-1">
												<div class="col-auto ml-sm-auto">
													<div class="input-group input-group-sm">
														<div class="input-group-prepend">
															<button class="btn btn-light border px-1" type="button" onclick="cart.updatePopup('{{ product.cart_id }}','{{ product.quantity_minus }}');">
																<svg class="d-block ft-icon-18 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
																	<path d="M19 13H5v-2h14v2z"/>
																</svg>
															</button>
														</div>
														<input type="text" class="form-control input-quantity border text-center" placeholder="" value="{{ product.quantity }}" onchange="cart.updatePopup('{{ product.cart_id }}', $(this).val());">
														<div class="input-group-append">
															<button class="btn btn-light border px-1" type="button" onclick="cart.updatePopup('{{ product.cart_id }}','{{ product.quantity_plus }}');">
																<svg class="d-block ft-icon-18 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
																	<path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
																</svg>
															</button>
															<button class="btn btn-light border px-1" type="button" onclick="cart.remove('{{ product.cart_id }}');" title="{{ button_remove }}" >
																<svg class="d-block ft-icon-18 m-0 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
																	<path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
																</svg>
															</button>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
							{% if not loop.last %}
								<hr class="mx-n3">
							{% endif %}
							{% endfor %}
							{% for voucher in vouchers %}
							<div class="row">
								<div class="col-auto">
									<div class="ml-2">
										<svg class="d-block ft-icon-18 text-gray-500" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
											<path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"/>
										</svg>
									</div>
								</div>
								<div class="col">
									<div class="text-center">{{ voucher.description }}</div>
								</div>
								<div class="col-auto">
									<a href="#" class="d-none d-sm-block mr-2" onclick="voucher.remove('{{ voucher.key }}');return false">
										<svg class="d-block ft-icon-18 text-gray-500 darker-on-hover" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
											<path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
										</svg>
									</a>
									<button type="button" class="close mr-1 d-block d-sm-none" onclick="voucher.remove('{{ voucher.key }}');">×</button>
								</div>
							</div>
							<hr class="mx-n3">
							{% endfor %}
						</div>
						<hr class="mx-n3 mt-2 mb-2">
						<div class="cart-totals">
							<div id="totals-details" >
								{% for total in totals %}
								<div class="row no-gutters">
									{% if total.code == 'sub_total' %}
									<div class="col-6 text-right"><span class="mr-2">{{ total.title }}{% if pixsel_tax_status %} {{ lang_with }}{% endif %}:</span></div>
									<div class="col-6 text-left"><strong>{{ total.text }}</strong></div>
										{% if pixsel_tax_status %}
											<div class="col-6 text-right"><span class="mr-2 text-gray-500">{{ total.title }}{% if pixsel_tax_status %} {{ lang_without }}{% endif %}:</span></div>
											<div class="col-6 text-left"><strong class="text-gray-500">{{ total.tax_text }}</strong></div>
										{% endif %}
									{% else %}
										<div class="col text-right"><span class="mr-2">{{ total.title }}:</span></div>
										<div class="col text-left"><strong>{{ total.text }}</strong></div>
									{% endif %}
								</div>
								{% endfor %}
							</div>
						</div>
						{% else %}
						<div class="cart-empty text-center p-3">
							{{ ft_text_empty }}
						</div>
						{% endif %}
					</div>
					<div class="cart-mask bg-white position-absolute t-0 b-0 l-0 r-0 d-none"></div>
				</div>
				<div class="modal-footer d-block px-0">
          <div class="m-0 px-3">
  					<div class="row">
  						<div class="col-12 col-sm-4 order-sm-3">
  							<a class="btn btn-primary btn-block text-truncate mb-3 mb-sm-0" href="{{ checkout }}">{{ ft_text_checkout }}</a>
  						</div>
  						<div class="col-5 col-sm-4 order-sm-1">
  							<a href="javascript:void(0);" class="btn btn-outline-primary btn-block text-truncate" data-dismiss="modal">{{ ft_text_continue }}</a>
  						</div>
  						<div class="col-7 col-sm-4 order-sm-2">
  							<a href="javascript:void(0);" onclick="clearCart();" class="btn btn-outline-primary btn-block text-truncate" data-dismiss="modal">{{ ft_text_clear_cart }}</a>
  						</div>
  					</div>
          </div>
				</div>
			</div>
		</div>
	</div>
</div>
